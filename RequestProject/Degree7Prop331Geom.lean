module

public import RequestProject.Degree7BoundaryMetric
public import RequestProject.Degree7ClosedQuotient

/-!
# Proposition 3.3.1 with the geometrically induced quotient metrics

This file assembles the geometric identification of the quotient orbisurfaces
`X_j = M_ε / H_j` of the actual completed degree-`168` covering surface `R̄ = RegFill hs f₀`.

* `LabelGeometry`: for one stabilizer subgroup `H` and its quotient map `Ev`, the package of
  proved identifications between the actual quotients `(interior M_ε)/H`, `M_ε/H` and the
  disk-coordinate orbisurface `pullbackOrb L hB`:
  - open and closed quotient homeomorphisms `Θ`, `Θc` (compatible on the interior), with
    `ψ ∘ Θ = (τ ε / a) · Ev`, `B ∘ Θ = b_ε`, and `∂M_ε` corresponding to the unit circle;
  - in every chart `e` of `R̄` at an interior point, the quotient map in coordinates
    `T = ψ⁻¹ ∘ (τ ε / a) · Ev ∘ e⁻¹` is holomorphic, represents `Θ`, satisfies `b_ε ∘ e⁻¹ = B ∘ T`,
    and the deck-invariant metric `regMetric L e` of `R̄` is the pull-back
    `λ_X(T) |T'|²` of the metric of `pullbackOrb L hB` (away from cone points);
  - the cone points of `pullbackOrb L hB` are exactly the images of points with nontrivial
    `H`-stabilizer, and each cone order equals the order of that stabilizer;
  - `|Stab_H(w)| · (local ramification of Ev at w) = inertia order of w`  (i.e. cone order `m/e`);
  - at the cusp points, the stabilizer is trivial when `Ev` is critical, and otherwise has order
    `d` (the base cone order) and is generated by the rotation `t ↦ e^{2πi/d} t` of the actual
    cusp chart;
  - at every boundary point of `M_ε`, in every chart, the closed quotient map is represented by a
    holomorphic `T` (analytic compatibility across the boundary), the metric is the pull-back of
    the metric of `pullbackOrb L hB`, equals the Euclidean collar metric `|d b_ε|²`, and the
    boundary line element `|B'|` pulls back to `|d b_ε|`.
* `prop_3_3_1_geometric`: Proposition 3.3.1 for the actual quotients with these induced metrics,
  together with the identification of the stabilizers `stabSub f₀ 0`, `stabSub f₀ 7` with
  conjugates of `GL3F2.HP`, `GL3F2.HL` (up to a label swap) and the smooth, positive,
  transition-compatible, deck-invariant metric on `R̄` for every base metric `L`.
-/

@[expose] public section

open Polynomial Set Filter Topology Metric PolyCover LocalMonodromy SteklovRegularCover
  SteklovPunctured SteklovFill SteklovRiemann Manifold SteklovOrb SteklovCoalescence
  SteklovCritical
open scoped ContDiff

noncomputable section

namespace Degree7

variable {s : ℂ}

/-- **The geometric identification package for one label.**  `H` is the stabilizer subgroup,
`Ev` its quotient map on `R̄`, `(ψ, B)` the normalized disk cover, `L` the base orbifold metric and
`hB` the branched-disk-map structure of `B` defining the disk-coordinate orbisurface
`pullbackOrb L hB`. -/
def LabelGeometry (hs : s ^ 2 = -7) (f₀ : OrdFib (projSum hs) 13) (H : Subgroup (deckGroup f₀))
    (P : ℂ[X]) (Ev : RegFill hs f₀ → ℂ) (ε : ℝ) (c : ℂ) (ψ B : ℂ → ℂ)
    (L : BaseOrbMetric (ε : ℂ) (lamStar * ε) 2 3) {V : Set ℂ}
    (hB : IsBranchedDiskMap B V (ε : ℂ) (lamStar * ε) 2 3 L.U) : Prop :=
  ∃ (Θ : QuotOn hs f₀ (interior (bordered hs f₀ ε)) H ≃ₜ ball (0 : ℂ) 1)
    (Θc : QuotOn hs f₀ (bordered hs f₀ ε) H ≃ₜ closedBall (0 : ℂ) 1),
    -- the open quotient is the unit disk, with projection `B`
    (∀ w, ψ (Θ (Quotient.mk _ w)) = c * Ev w ∧ B (Θ (Quotient.mk _ w)) = bdf hs f₀ ε w) ∧
    -- the closed quotient is the closed unit disk, compatibly, with `∂M_ε ↔ circle`
    (∀ (w : RegFill hs f₀) (hi : w ∈ interior (bordered hs f₀ ε)),
      (Θc (Quotient.mk _ ⟨w, interior_subset hi⟩) : ℂ) = Θ (Quotient.mk _ ⟨w, hi⟩)) ∧
    (∀ w : bordered hs f₀ ε, B (Θc (Quotient.mk _ w)) = bdf hs f₀ ε w) ∧
    (∀ w : bordered hs f₀ ε, (w : RegFill hs f₀) ∈ borderedBdry hs f₀ ε ↔
      (Θc (Quotient.mk _ w) : ℂ) ∈ sphere (0 : ℂ) 1) ∧
    -- the quotient map in charts and the descent of the metric of `R̄` (interior)
    (∀ e ∈ atlas ℂ (RegFill hs f₀), ∀ z ∈ e.target, ∀ hzi : e.symm z ∈ interior (bordered hs f₀ ε),
      AnalyticAt ℂ (fun x => Function.invFunOn ψ (ball 0 1) (c * Ev (e.symm x))) z ∧
      (∀ᶠ x in 𝓝 z, ∃ hx : e.symm x ∈ interior (bordered hs f₀ ε),
        (Θ (Quotient.mk _ ⟨e.symm x, hx⟩) : ℂ) =
          Function.invFunOn ψ (ball 0 1) (c * Ev (e.symm x))) ∧
      (bdf hs f₀ ε ∘ e.symm) =ᶠ[𝓝 z]
        B ∘ (fun x => Function.invFunOn ψ (ball 0 1) (c * Ev (e.symm x))) ∧
      ((Θ (Quotient.mk _ ⟨e.symm z, hzi⟩) : ℂ) ∉ coneSet B V (ε : ℂ) (lamStar * ε) →
        regMetric L e z =
          (pullbackOrb L hB).lam (Function.invFunOn ψ (ball 0 1) (c * Ev (e.symm z))) *
            ‖deriv (fun x => Function.invFunOn ψ (ball 0 1) (c * Ev (e.symm x))) z‖ ^ 2)) ∧
    -- cone points and cone orders = stabilizers
    (∀ w : interior (bordered hs f₀ ε),
      (Θ (Quotient.mk _ w) : ℂ) ∈ coneSet B V (ε : ℂ) (lamStar * ε) ↔
        Nat.card (stabIn H (w : RegFill hs f₀)) ≠ 1) ∧
    (∀ (w : interior (bordered hs f₀ ε)) (i : Fin (pullbackOrb L hB).n),
      (pullbackOrb L hB).pt i = Θ (Quotient.mk _ w) →
        (pullbackOrb L hB).ord i = Nat.card (stabIn H (w : RegFill hs f₀))) ∧
    (∀ w : RegFill hs f₀,
      Nat.card (stabIn H w) * rootMultiplicity (Ev w) (P - C (P.eval (Ev w))) = inertiaOrd w) ∧
    -- the stabilizers at the cusps: trivial or finite rotations of the actual cusp chart
    (∀ j : BIdx (regProj f₀) cB (1 / 2),
      (P.derivative.eval (Ev (Fill.cusp j)) = 0 → stabIn H (Fill.cusp j : RegFill hs f₀) = ⊥) ∧
      (P.derivative.eval (Ev (Fill.cusp j)) ≠ 0 →
        Nat.card (stabIn H (Fill.cusp j : RegFill hs f₀)) = dB j.1 ∧
        ∃ σ ∈ stabIn H (Fill.cusp j : RegFill hs f₀), ∀ t ∈ ball (0 : ℂ) ((regEnds hs f₀).r j),
          regFillAct hs f₀ σ ((Fill.cuspChart (E := regEnds hs f₀) j).symm t) =
            (Fill.cuspChart (E := regEnds hs f₀) j).symm
              (Complex.exp (2 * Real.pi * Complex.I / (dB j.1 : ℂ)) * t))) ∧
    -- the boundary: analytic compatibility, metric, collar and line element
    (∀ w ∈ borderedBdry hs f₀ ε, ∀ e ∈ atlas ℂ (RegFill hs f₀), w ∈ e.source →
      ∃ T : ℂ → ℂ, AnalyticAt ℂ T (e w) ∧
        (∀ᶠ x in 𝓝 (e w), ∀ hx : e.symm x ∈ bordered hs f₀ ε,
          (Θc (Quotient.mk _ ⟨e.symm x, hx⟩) : ℂ) = T x) ∧
        (bdf hs f₀ ε ∘ e.symm) =ᶠ[𝓝 (e w)] B ∘ T ∧
        T (e w) ∈ sphere (0 : ℂ) 1 ∧
        regMetric L e (e w) = (pullbackOrb L hB).lam (T (e w)) * ‖deriv T (e w)‖ ^ 2 ∧
        regMetric L e (e w) = ‖deriv (bdf hs f₀ ε ∘ e.symm) (e w)‖ ^ 2 ∧
        (pullbackOrb L hB).lineDensity (T (e w)) * ‖deriv T (e w)‖ =
          ‖deriv (bdf hs f₀ ε ∘ e.symm) (e w)‖)

/-- **The geometric package holds for each label** of the paper's family, for every base
orbifold metric `L` and branched-disk-map structure `hB` of `B`. -/
theorem label_geometry (hs : s ^ 2 = -7) (f₀ : OrdFib (projSum hs) 13)
    (H : Subgroup (deckGroup f₀)) {t : ℂ} (ht : t ^ 2 = -7) {Ev : RegFill hs f₀ → ℂ}
    (hEv : haveI := (regFill_riemannSurface hs f₀).2.1; ContMDiff 𝓘(ℂ) 𝓘(ℂ) ω Ev)
    (hPEv : ∀ w, (pPoly t).eval (Ev w) = regFillProj hs f₀ w)
    (hpr : IsProperMap Ev) (hsurj : Function.Surjective Ev)
    (hfib : ∀ w w', Ev w = Ev w' ↔ ∃ σ ∈ H, regFillAct hs f₀ σ w = w')
    (hq : ∀ (ε : ℝ) w, (SteklovDiskCovers.coverPoly (pPoly t) ε).eval (Ev w) =
      affA ε (regFillProj hs f₀ w))
    {a : ℂ} (ha : a ^ 7 = -bconst t) {τ : ℝ → ℂ} (hτ : ∀ ε, τ ε ^ 7 = (lamStar - 1) * ε)
    {ε : ℝ} (h0 : 0 < ε) (h1 : ε < 1 / 3)
    (hconn : IsPreconnected (paperQ (monicP t a) τ ε ⁻¹' ball 0 1))
    {ψ B : ℂ → ℂ} (hc : IsNormalizedDiskCover (paperQ (monicP t a) τ ε) 7 ψ B)
    (L : BaseOrbMetric (ε : ℂ) (lamStar * ε) 2 3) {V : Set ℂ}
    (hB : IsBranchedDiskMap B V (ε : ℂ) (lamStar * ε) 2 3 L.U) :
    LabelGeometry hs f₀ H (pPoly t) Ev ε (τ ε / a) ψ B L hB := by
  have ha0 := a_ne_zero ht ha
  have hτ0 := tau_ne_zero hτ h0
  have hc0 : τ ε / a ≠ 0 := div_ne_zero hτ0 ha0
  have hcfun : ∀ x : ℂ, τ ε / a * x = τ ε * x / a := fun x => by ring
  -- closed quotient
  obtain ⟨Θc, Ψ, hΘc, hΨi, hΨψ, hS, -⟩ :=
    closed_quotient_disk hs f₀ H ht hpr hsurj hfib hq ha hτ h0 h1 hconn hc
  -- open quotient
  obtain ⟨-, -, ⟨Φ, hΦ⟩, -⟩ := quotient_spaces_of_ev hs f₀ H hpr hsurj hfib hq h0 h1 _ hc0
  have hset : {z : ℂ | ‖(SteklovDiskCovers.coverPoly (pPoly t) ε).eval (z / (τ ε / a))‖ < 1} =
      {z | ‖paperQ (monicP t a) τ ε z‖ < 1} := by
    ext z; simp only [mem_setOf_eq, paperQ_monicP_eq ht ha]
  obtain ⟨Θ, hΘ⟩ := quotient_disk_of hc hconn hset Φ
  have hΘ' : ∀ w, ψ (Θ (Quotient.mk _ w)) = τ ε * Ev w / a ∧
      B (Θ (Quotient.mk _ w)) = bdf hs f₀ ε w := by
    intro w
    obtain ⟨e1, e2⟩ := hΘ (Quotient.mk _ w)
    rw [hΦ] at e1 e2
    refine ⟨by rw [e1, hcfun], ?_⟩
    rw [e2, paperQ_monicP_eq ht ha, mul_div_cancel_left₀ _ hc0]
    exact hq ε w
  have hΘc' : ∀ w : interior (bordered hs f₀ ε),
      ψ (Θ (Quotient.mk _ w)) = (fun x => τ ε * x / a) (Ev w) ∧
        B (Θ (Quotient.mk _ w)) = bdf hs f₀ ε w := hΘ'
  have hK : Differentiable ℂ (fun x : ℂ => τ ε * x / a) := by fun_prop
  have hψd := hc.1
  have hψi := hc.2.1
  refine ⟨Θ, Θc, fun w => ?_, ?_, fun w => (hΘc w).2, hS, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hcfun]; exact hΘ' w
  · intro w hi
    have h1' := (hΘc ⟨w, interior_subset hi⟩).1
    have h2' := (hΘ' ⟨w, hi⟩).1
    have hmem := (Θ (Quotient.mk _ ⟨w, hi⟩)).2
    apply hΨi (Θc _).2 (ball_subset_closedBall hmem)
    rw [h1', hΨψ _ hmem, h2']
  · intro e he z hz hzi
    obtain ⟨A1, A2, A3⟩ := quotient_chart hEv hK hψd hψi Θ hΘc' he hz hzi
    simp only [hcfun]
    refine ⟨A1, A2, A3, fun hcone => ?_⟩
    have hT : (Θ (Quotient.mk _ ⟨e.symm z, hzi⟩) : ℂ) =
        Function.invFunOn ψ (ball 0 1) (τ ε * Ev (e.symm z) / a) := by
      have h := (hΘ' ⟨e.symm z, hzi⟩).1
      have hmem := (Θ (Quotient.mk _ ⟨e.symm z, hzi⟩)).2
      rw [← h]
      exact (hψi.leftInvOn_invFunOn hmem).symm
    rw [hT] at hcone
    exact metric_descends h0 L hEv hK hψd hψi Θ hΘc' hB he hz hzi hcone
  · exact fun w => coneSet_iff_stab ht ha hτ h0 hEv hPEv hfib hc Θ hΘ' hB w
  · exact fun w i hi => ord_eq_stab ht ha hτ h0 hEv hPEv hfib hc Θ hΘ' L hB w i hi
  · exact fun w => stab_card_mul_mult ht hEv hPEv hfib w
  · intro j
    exact ⟨fun hcrit => (stab_card_crit hEv (pPoly_degree_pos ht) hPEv hfib j hcrit).1,
      fun hreg => stab_card_noncrit hEv hPEv hfib j hreg⟩
  · intro w hw e he hwe
    exact boundary_metric h0 L hB Θc (fun w => (hΘc w).2) hS hw he hwe

/-- **Proposition 3.3.1 for the actual quotients `X_j = M_ε / H_j` with the geometrically induced
metrics.**  For `s² = -7` there is an ordered fibre `f₀` of the common regular cover such that:

* the deck group has order `168`, and under an explicit isomorphism `ι : GL(3, 𝔽₂) ≃* deck`
  (given by the actual combined monodromy representation) the point and line stabilizers
  `H_P = stabSub f₀ 0`, `H_L = stabSub f₀ 7` are the images of conjugates of `GL3F2.HP`,
  `GL3F2.HL` (or, with the labels swapped, of `GL3F2.HL`, `GL3F2.HP`);
* the holomorphic quotient maps `Ev₁, Ev₂ : R̄ → ℂ` have fibres the `H_P`-, `H_L`-orbits;
* for every `0 < ε < 1/3` and every base orbifold metric `L`, the pull-back `regMetric L` through
  `b_ε` is a smooth positive conformal factor in every chart of the actual completed surface `R̄`
  (including the cusp charts at the filled points), given by `L.lam(b_ε)|d b_ε|²` off the branch
  fibres, obeying the conformal transition law between charts and invariant under every deck
  transformation (local isometry), and it is defined on all of `M_ε`;
* for all paper normalisations `a_P, a_L, τ`, all small `ε > 0`, all normalized disk covers
  `(ψ_P, B_P)`, `(ψ_L, B_L)` and **every** base orbifold metric `L`, the maps `B_P`, `B_L` are
  branched disk maps for which the full geometric identification `LabelGeometry` holds (the
  actual open/closed quotients are the open/closed disk, the metric of `R̄` descends to the metric
  of `pullbackOrb L h_j` in the interior and at the boundary, cone orders are stabilizer orders,
  the boundary line element is compatible), and the two quotient orbisurfaces have equal
  Riemannian orbifold Steklov spectra with multiplicities. -/
theorem prop_3_3_1_geometric (hs : s ^ 2 = -7) :
    ∃ f₀ : OrdFib (projSum hs) 13, Nat.card (deckGroup f₀) = 168 ∧
      (∃ ι : GL3F2.G ≃* deckGroup f₀, ∃ a b : GL3F2.G,
        ((∀ g, ((ι g : deckGroup f₀) : Equiv.Perm (Fin 14)) = combRho rhoP rhoL g) ∧
          stabSub f₀ 0 = (GL3F2.HP.map (MulAut.conj a).toMonoidHom).map ι.toMonoidHom ∧
          stabSub f₀ 7 = (GL3F2.HL.map (MulAut.conj b).toMonoidHom).map ι.toMonoidHom) ∨
        ((∀ g, ((ι g : deckGroup f₀) : Equiv.Perm (Fin 14)) = combRho rhoL rhoP g) ∧
          stabSub f₀ 0 = (GL3F2.HL.map (MulAut.conj a).toMonoidHom).map ι.toMonoidHom ∧
          stabSub f₀ 7 = (GL3F2.HP.map (MulAut.conj b).toMonoidHom).map ι.toMonoidHom)) ∧
      ∃ Ev₁ Ev₂ : RegFill hs f₀ → ℂ,
        ContMDiff 𝓘(ℂ) 𝓘(ℂ) ω Ev₁ ∧ ContMDiff 𝓘(ℂ) 𝓘(ℂ) ω Ev₂ ∧
        (∀ w, (pPoly s).eval (Ev₁ w) = regFillProj hs f₀ w) ∧
        (∀ w, (pPoly (-s)).eval (Ev₂ w) = regFillProj hs f₀ w) ∧
        (∀ w w', Ev₁ w = Ev₁ w' ↔ (orbSetoid hs f₀ (stabSub f₀ 0)) w w') ∧
        (∀ w w', Ev₂ w = Ev₂ w' ↔ (orbSetoid hs f₀ (stabSub f₀ 7)) w w') ∧
        (∀ ε : ℝ, 0 < ε → ε < 1 / 3 → ∀ L : BaseOrbMetric (ε : ℂ) (lamStar * ε) 2 3,
          bordered hs f₀ ε ⊆ bdf hs f₀ ε ⁻¹' L.U ∧
          (∀ e ∈ atlas ℂ (RegFill hs f₀), ∀ z ∈ chartDom L e,
            ContDiffAt ℝ ∞ (regMetric L e) z ∧ 0 < regMetric L e z) ∧
          (∀ e ∈ atlas ℂ (RegFill hs f₀), ∀ z ∈ chartDom L e,
            bdf hs f₀ ε (e.symm z) ≠ ε → bdf hs f₀ ε (e.symm z) ≠ lamStar * ε →
            regMetric L e z = L.lam (bdf hs f₀ ε (e.symm z)) *
              ‖deriv (bdf hs f₀ ε ∘ e.symm) z‖ ^ 2) ∧
          (∀ j : BIdx (regProj f₀) cB (1 / 2),
            (∀ t ∈ ball (0 : ℂ) ((regEnds hs f₀).r j),
              bdf hs f₀ ε ((Fill.cuspChart (E := regEnds hs f₀) j).symm t) =
                affA ε (cB j.1 + t ^ (dB j.1))) ∧
            0 ∈ chartDom L (Fill.cuspChart (E := regEnds hs f₀) j) ∧
            ContDiffAt ℝ ∞ (regMetric L (Fill.cuspChart (E := regEnds hs f₀) j)) 0 ∧
            0 < regMetric L (Fill.cuspChart (E := regEnds hs f₀) j) 0) ∧
          (∀ e ∈ atlas ℂ (RegFill hs f₀), ∀ e' ∈ atlas ℂ (RegFill hs f₀), ∀ z ∈ chartDom L e,
            e.symm z ∈ e'.source →
            AnalyticAt ℂ (e' ∘ e.symm) z ∧ regMetric L e z =
              regMetric L e' ((e' ∘ e.symm) z) * ‖deriv (e' ∘ e.symm) z‖ ^ 2) ∧
          (∀ σ : deckGroup f₀, ∀ e ∈ atlas ℂ (RegFill hs f₀), ∀ e' ∈ atlas ℂ (RegFill hs f₀),
            ∀ z ∈ chartDom L e, regFillAct hs f₀ σ (e.symm z) ∈ e'.source →
            AnalyticAt ℂ (e' ∘ regFillAct hs f₀ σ ∘ e.symm) z ∧
              (e' ∘ regFillAct hs f₀ σ ∘ e.symm) z ∈ chartDom L e' ∧
              regMetric L e z = regMetric L e' ((e' ∘ regFillAct hs f₀ σ ∘ e.symm) z) *
                ‖deriv (e' ∘ regFillAct hs f₀ σ ∘ e.symm) z‖ ^ 2)) ∧
        ∀ (aP aL : ℂ), aP ^ 7 = -bconst s → aL ^ 7 = -bconst (-s) →
        ∀ (τ : ℝ → ℂ), (∀ ε, τ ε ^ 7 = (lamStar - 1) * ε) →
        ∀ᶠ ε in 𝓝[>] (0 : ℝ), ∀ ψP BP ψL BL : ℂ → ℂ,
          IsNormalizedDiskCover (paperQ (monicP s aP) τ ε) 7 ψP BP →
          IsNormalizedDiskCover (paperQ (monicP (-s) aL) τ ε) 7 ψL BL →
          ∀ L : BaseOrbMetric (ε : ℂ) (lamStar * ε) 2 3,
            ∃ (VP VL : Set ℂ) (hP : IsBranchedDiskMap BP VP (ε : ℂ) (lamStar * ε) 2 3 L.U)
              (hL : IsBranchedDiskMap BL VL (ε : ℂ) (lamStar * ε) 2 3 L.U),
              LabelGeometry hs f₀ (stabSub f₀ 0) (pPoly s) Ev₁ ε (τ ε / aP) ψP BP L hP ∧
              LabelGeometry hs f₀ (stabSub f₀ 7) (pPoly (-s)) Ev₂ ε (τ ε / aL) ψL BL L hL ∧
              (pullbackOrb L hP).metricSteklovEigenvalue =
                (pullbackOrb L hL).metricSteklovEigenvalue ∧
              (pullbackOrb L hP).steklovSpectrum = (pullbackOrb L hL).steklovSpectrum := by
  obtain ⟨f₀, hd, -, hcard, -, -, Ev₁, Ev₂, hE₁, hE₂, e₁, e₂, fib₁, fib₂, su₁, su₂, pr₁, pr₂,
    q₁, q₂⟩ := completed_quotient_identifications_deck hs
  have hs' : (-s) ^ 2 = -7 := by rw [neg_sq]; exact hs
  refine ⟨f₀, hcard, stabilizer_identification hd, Ev₁, Ev₂, hE₁, hE₂, e₁, e₂, fib₁, fib₂,
    fun ε h0 h1 L => ⟨bordered_subset_metricDom L,
      fun e he z hz => regMetric_smooth h0 L he hz,
      fun e he z hz hu hv => regMetric_eq h0 L he hz hu hv,
      fun j => ?_,
      fun e he e' he' z hz hz' => regMetric_transition h0 L he he' hz hz',
      fun σ e he e' he' z hz hzσ => regMetric_deck h0 L σ he he' hz hzσ⟩,
    fun aP aL haP haL τ hτ => ?_⟩
  · obtain ⟨c1, -, c3, c4, c5⟩ := regMetric_cusp (hs := hs) (f₀ := f₀) h0 h1 L j
    exact ⟨c1, c3, c4, c5⟩
  obtain ⟨ε₁, hε₁, HP⟩ := FamilyNoncongr.family_facts hs haP hτ
  obtain ⟨ε₂, hε₂, HL⟩ := FamilyNoncongr.family_facts hs' haL hτ
  have hpos : 0 < min (min ε₁ ε₂) (1 / 10 : ℝ) := lt_min (lt_min hε₁ hε₂) (by norm_num)
  filter_upwards [eventually_isPreconnected_paperQ hs haP hτ,
    eventually_isPreconnected_paperQ hs' haL hτ, Ioo_mem_nhdsGT hpos] with ε hcnP hcnL hεI
  intro ψP BP ψL BL hcP hcL L
  obtain ⟨h0, hlt⟩ := hεI
  have hlt1 : ε < ε₁ := lt_of_lt_of_le hlt ((min_le_left _ _).trans (min_le_left _ _))
  have hlt2 : ε < ε₂ := lt_of_lt_of_le hlt ((min_le_left _ _).trans (min_le_right _ _))
  have hlt3 : ε < 1 / 10 := lt_of_lt_of_le hlt (min_le_right _ _)
  have h13 : ε < 1 / 3 := by linarith
  have critP := (HP ε h0 hlt1 ψP BP hcP).2
  have critL := (HL ε h0 hlt2 ψL BL hcL).2
  obtain ⟨VP, hP⟩ := isBranchedDiskMap_of_cover hs haP hτ h0 h13 hcP critP L.isOpen_U L.cb
  obtain ⟨VL, hL⟩ := isBranchedDiskMap_of_cover hs' haL hτ h0 h13 hcL critL L.isOpen_U L.cb
  have spec := FamilyIso.family_spectra_eq hs haP haL hτ h0 hlt3 hcP hcL
  refine ⟨VP, VL, hP, hL, ?_, ?_, pullback_spectra_eq hP hL spec⟩
  · exact label_geometry hs f₀ (stabSub f₀ 0) hs hE₁ e₁ pr₁ su₁ fib₁ q₁ haP hτ h0 h13 hcnP hcP L hP
  · exact label_geometry hs f₀ (stabSub f₀ 7) hs' hE₂ e₂ pr₂ su₂ fib₂ q₂ haL hτ h0 h13 hcnL hcL L hL

/-- The universally quantified statement is not vacuous: the class of base orbifold metrics is
nonempty for `0 < ε < 1/3` (re-export of `baseOrbMetric_nonempty`). -/
theorem prop_3_3_1_geometric_nonvacuous {ε : ℝ} (h0 : 0 < ε) (h1 : ε < 1 / 3) :
    Nonempty (BaseOrbMetric (ε : ℂ) (lamStar * ε) 2 3) :=
  baseOrbMetric_nonempty h0 h1

end Degree7
