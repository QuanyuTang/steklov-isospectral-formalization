#audit_proof Degree7.completed_quotient_identifications_conn
#audit_proof Degree7.regFill_connected_of
#audit_proof Degree7.prop_3_3_1_full

example {s : ℂ} (hs : s ^ 2 = -7)
    (f₀ : SteklovRegularCover.OrdFib (Degree7.projSum hs) 13)
    (Ev : Degree7.RegFill hs f₀ → ℂ) (c : ℂ) (ψ : ℂ → ℂ)
    (j : SteklovFill.BIdx (SteklovRegularCover.regProj f₀) Degree7.cB (1 / 2)) :
    ℂ → ℂ := Degree7.cuspT hs f₀ Ev c ψ j
#check Degree7.CuspCompat
#check Degree7.CuspCompat.cone_metric_identity
#check Degree7.label_geometry_cone
#check Degree7.prop_3_3_1_full
example : SteklovC1.Prop_2_1_1_C1_Weak := SteklovC1.prop_2_1_1_C1_weak
example : Prop_2_3_1_complete := OuterConvergence.prop_2_3_1_complete
#check SteklovC1.prop_2_1_1_C1_weak
#check SteklovOrb.DiskOrbisurface.prop_2_2_1_metric
#check OuterConvergence.prop_2_3_1_complete
#check SteklovBlaschke.blaschke_boundary_rigidity
#check SteklovBlaschke.blaschke_boundary_rigidity_anti
#check group_input
#check GL3F2.group_input_GL
#check SteklovDiskCovers.lemma_3_2_1
#check SteklovCoalescence.prop_3_4_1_unconditional
example : MainTheorem := SteklovCoalescence.mainTheorem_proved
#check SteklovCoalescence.mainTheorem_proved
example : MainTheoremClassical := SteklovCoalescence.mainTheoremClassical_proved
#check SteklovCoalescence.mainTheoremClassical_proved
end
