module

public import RequestProject.Degree7ClosedQuotient

/-!
# Stabilizers of the actual quotient actions: rotations, orders and local power maps

For a subgroup `H` of the deck group acting on `R̄` by the extended deck transformations, and a
quotient coordinate `Ev : R̄ → ℂ` (holomorphic, `P ∘ Ev = π̄`, fibres = `H`-orbits), we compute the
**stabilizer `stabIn H w = {σ ∈ H | σ w = w}`** of each point:

* `stabIn_inl`: at points of the unbranched cover it is trivial (the action is free there);
* `rot_formula`: an element fixing a filled point `j` acts in the actual cusp chart as the finite
  rotation `t ↦ ζ t`, `ζ^dB = 1`;
* `stab_card_crit`: if `Ev(j)` is a critical point of `P`, then `stabIn H j` is trivial;
* `stab_card_noncrit`: if `Ev(j)` is a regular point of `P`, then `stabIn H j` has order exactly
  `dB j` (the full inertia order `2` over `0`, `3` over `1`); it is generated by an element acting by
  the primitive rotation `exp(2πi/dB)`;
* `local_power_map`: in the latter case `Ev` is, in the cusp chart, `G(cB + t^dB)` with `G` a local
  inverse of `P`: the quotient map is locally the power map `t ↦ t^dB` followed by a local
  biholomorphism.
-/

@[expose] public section

open Polynomial Set Filter Topology Metric PolyCover LocalMonodromy SteklovRegularCover
  SteklovPunctured SteklovFill SteklovRiemann Manifold SteklovOrb SteklovCoalescence
  SteklovCritical
open scoped ContDiff

noncomputable section

namespace Degree7

variable {s : ℂ} {hs : s ^ 2 = -7} {f₀ : OrdFib (projSum hs) 13}

/-- The stabilizer of a point `w` in a subgroup `H` acting by extended deck transformations. -/
def stabIn (H : Subgroup (deckGroup f₀)) (w : RegFill hs f₀) : Subgroup (deckGroup f₀) where
  carrier := {σ | σ ∈ H ∧ regFillAct hs f₀ σ w = w}
  one_mem' := ⟨H.one_mem, by rw [regFillAct_one]; rfl⟩
  mul_mem' := by
    rintro σ τ ⟨hσ, hσw⟩ ⟨hτ, hτw⟩
    refine ⟨H.mul_mem hσ hτ, ?_⟩
    rw [regFillAct_mul, Function.comp_apply, hσw, hτw]
  inv_mem' := by
    rintro σ ⟨hσ, hσw⟩
    refine ⟨H.inv_mem hσ, ?_⟩
    conv_lhs => rw [← hσw]
    rw [← Function.comp_apply (f := regFillAct hs f₀ σ⁻¹), ← regFillAct_mul, mul_inv_cancel,
      regFillAct_one]; rfl

lemma mem_stabIn {H : Subgroup (deckGroup f₀)} {w : RegFill hs f₀} {σ : deckGroup f₀} :
    σ ∈ stabIn H w ↔ σ ∈ H ∧ regFillAct hs f₀ σ w = w := Iff.rfl

/-- Two deck transformations agreeing at a point off the branch fibres are equal. -/
lemma eq_of_act_eq {σ τ : deckGroup f₀} {w : RegFill hs f₀} (hw0 : regFillProj hs f₀ w ≠ 0)
    (hw1 : regFillProj hs f₀ w ≠ 1) (h : regFillAct hs f₀ σ w = regFillAct hs f₀ τ w) :
    σ = τ := by
  have hfix : regFillAct hs f₀ (σ * τ⁻¹) w = w := by
    rw [regFillAct_mul, Function.comp_apply, h, ← Function.comp_apply (f := regFillAct hs f₀ τ⁻¹),
      ← regFillAct_mul, mul_inv_cancel, regFillAct_one]; rfl
  exact mul_inv_eq_one.1 ((regFill_deckAction hs f₀).2.2.2.2.2.2.2.2 _ w hw0 hw1 hfix)

/-- **The action is free off the branch fibres**: stabilizers of unbranched points are trivial. -/
theorem stabIn_inl (H : Subgroup (deckGroup f₀)) (f : RegCov f₀) :
    stabIn H (Fill.inl f : RegFill hs f₀) = ⊥ := by
  have h := coverProjC_not_mem hs f₀ f
  simp only [mem_insert_iff, mem_singleton_iff, not_or] at h
  ext σ
  simp only [mem_stabIn, Subgroup.mem_bot]
  constructor
  · rintro ⟨-, hσ⟩
    exact (regFill_deckAction hs f₀).2.2.2.2.2.2.2.2 σ (Fill.inl f) h.1 h.2 hσ
  · rintro rfl
    exact ⟨Subgroup.one_mem _, by rw [regFillAct_one]; rfl⟩

lemma cusp_act (σ : deckGroup f₀) (j : BIdx (regProj f₀) cB (1 / 2)) :
    regFillAct hs f₀ σ (Fill.cusp j) = Fill.cusp (cuspAct hs f₀ σ j) :=
  ((regFill_deckAction hs f₀).2.2.2.2.1 σ j).1

lemma cuspAct_eq_of_fix {σ : deckGroup f₀} {j : BIdx (regProj f₀) cB (1 / 2)}
    (h : regFillAct hs f₀ σ (Fill.cusp j) = Fill.cusp j) : cuspAct hs f₀ σ j = j := by
  rw [cusp_act] at h; exact Fill.cusp_injective h

lemma cuspChart_symm_zero (j : BIdx (regProj f₀) cB (1 / 2)) :
    (Fill.cuspChart (E := regEnds hs f₀) j).symm 0 = Fill.cusp j :=
  Fill.cuspInv_zero (E := regEnds hs f₀) j

lemma cuspChart_mem_atlas (j : BIdx (regProj f₀) cB (1 / 2)) :
    Fill.cuspChart (E := regEnds hs f₀) j ∈ atlas ℂ (RegFill hs f₀) :=
  Fill.mem_atlas_iff.2 (Or.inr ⟨j, rfl⟩)

/-- Off the centre, the cusp chart parametrizes unbranched points. -/
lemma cusp_symm_generic (j : BIdx (regProj f₀) cB (1 / 2)) {t : ℂ}
    (ht : t ∈ ball (0 : ℂ) ((regEnds hs f₀).r j)) (ht0 : t ≠ 0) :
    regFillProj hs f₀ ((Fill.cuspChart (E := regEnds hs f₀) j).symm t) ≠ 0 ∧
      regFillProj hs f₀ ((Fill.cuspChart (E := regEnds hs f₀) j).symm t) ≠ 1 := by
  obtain ⟨f, hf⟩ := cuspChart_symm_inl j ht ht0
  rw [hf, regFillProj_inl]
  have h := coverProjC_not_mem hs f₀ f
  simp only [mem_insert_iff, mem_singleton_iff, not_or] at h
  exact h

/-- **Elements fixing a filled point act as finite rotations in the actual cusp chart.** -/
theorem rot_formula (σ : deckGroup f₀) (j : BIdx (regProj f₀) cB (1 / 2))
    (hσj : cuspAct hs f₀ σ j = j) :
    ∃ ζ : ℂ, ζ ^ (dB j.1) = 1 ∧ ∀ t ∈ ball (0 : ℂ) ((regEnds hs f₀).r j),
      regFillAct hs f₀ σ ((Fill.cuspChart (E := regEnds hs f₀) j).symm t) =
        (Fill.cuspChart (E := regEnds hs f₀) j).symm (ζ * t) := by
  obtain ⟨ζ, hζ, hrot⟩ := (regFill_deckAction hs f₀).2.2.2.2.2.2.2.1 σ j
  refine ⟨ζ, hζ, fun t ht => ?_⟩
  have h1 := hrot t ht
  rw [hσj] at h1
  have hmem : regFillAct hs f₀ σ ((Fill.cuspChart (E := regEnds hs f₀) j).symm t) ∈
      (Fill.cuspChart (E := regEnds hs f₀) j).source := by
    by_cases ht0 : t = 0
    · subst ht0
      rw [cuspChart_symm_zero, cusp_act, hσj]
      exact Fill.mem_cuspSet.2 (Or.inr rfl)
    · have hp : t ∈ pdisk ((regEnds hs f₀).r j) := ⟨ht0, mem_ball_zero_iff.1 ht⟩
      have hsymm : (Fill.cuspChart (E := regEnds hs f₀) j).symm t =
          Fill.inl (((regEnds hs f₀).Φ j).symm ⟨t, hp⟩ : RegCov f₀) :=
        Fill.cuspInv_of_mem (E := regEnds hs f₀) hp
      rw [hsymm]
      set y := ((regEnds hs f₀).Φ j).symm ⟨t, hp⟩
      obtain ⟨hy, -⟩ := endCompat_regAct hs f₀ σ j y.1 y.2
      rw [hσj] at hy
      exact Fill.mem_cuspSet.2 (Or.inl ⟨_, hy, rfl⟩)
  rw [← h1, (Fill.cuspChart (E := regEnds hs f₀) j).left_inv hmem]

lemma norm_root_one {ζ : ℂ} {m : ℕ} (hm : m ≠ 0) (hζ : ζ ^ m = 1) : ‖ζ‖ = 1 :=
  Complex.norm_eq_one_of_pow_eq_one hζ hm

variable {H : Subgroup (deckGroup f₀)} {Ev : RegFill hs f₀ → ℂ} {P : ℂ[X]}

lemma eval_E_cusp (hPEv : ∀ w, P.eval (Ev w) = regFillProj hs f₀ w)
    (j : BIdx (regProj f₀) cB (1 / 2)) {t : ℂ} (ht : t ∈ ball (0 : ℂ) ((regEnds hs f₀).r j)) :
    P.eval (Ev ((Fill.cuspChart (E := regEnds hs f₀) j).symm t)) = cB j.1 + t ^ (dB j.1) := by
  rw [hPEv, regFillProj_cusp_symm j ht]

lemma Ev_inv (hfib : ∀ w w', Ev w = Ev w' ↔ ∃ σ ∈ H, regFillAct hs f₀ σ w = w') {σ : deckGroup f₀}
    (hσ : σ ∈ H) (w : RegFill hs f₀) : Ev (regFillAct hs f₀ σ w) = Ev w :=
  ((hfib w _).2 ⟨σ, hσ, rfl⟩).symm

lemma dB_le_three (b : Bool) : 2 ≤ dB b ∧ dB b ≤ 3 := by cases b <;> decide

/-- **At a critical point of `P` the stabilizer is trivial.** -/
theorem stab_card_crit
    (hEv : haveI := (regFill_riemannSurface hs f₀).2.1; ContMDiff 𝓘(ℂ) 𝓘(ℂ) ω Ev)
    (hPdeg : 0 < P.degree) (hPEv : ∀ w, P.eval (Ev w) = regFillProj hs f₀ w)
    (hfib : ∀ w w', Ev w = Ev w' ↔ ∃ σ ∈ H, regFillAct hs f₀ σ w = w')
    (j : BIdx (regProj f₀) cB (1 / 2)) (hcrit : P.derivative.eval (Ev (Fill.cusp j)) = 0) :
    stabIn H (Fill.cusp j : RegFill hs f₀) = ⊥ ∧
      deriv (fun t => Ev ((Fill.cuspChart (E := regEnds hs f₀) j).symm t)) 0 ≠ 0 := by
  haveI := (regFill_riemannSurface hs f₀).2.1
  set χ := Fill.cuspChart (E := regEnds hs f₀) j
  set r := (regEnds hs f₀).r j
  have hr : 0 < r := (regEnds hs f₀).r_pos j
  set m := dB j.1
  set c := cB j.1
  have hm := dB_le_three j.1
  set E : ℂ → ℂ := fun t => Ev (χ.symm t)
  set y₀ := Ev (Fill.cusp j)
  have hE0 : E 0 = y₀ := by
    show Ev (χ.symm 0) = y₀
    rw [cuspChart_symm_zero]
  have hEa : AnalyticAt ℂ E 0 :=
    analyticAt_chart_fun hEv (cuspChart_mem_atlas j) (mem_ball_self hr)
  have hPE : ∀ t ∈ ball (0 : ℂ) r, P.eval (E t) = c + t ^ m := fun t ht => eval_E_cusp hPEv j ht
  have hPy₀ : P.eval y₀ = c := by
    have := hPE 0 (mem_ball_self hr)
    rwa [hE0, zero_pow (by omega), add_zero] at this
  -- Step 1: `E'(0) ≠ 0`
  have hd : deriv E 0 ≠ 0 := by
    intro hd0
    have hne : P - C c ≠ 0 := by
      intro h
      have : P = C c := sub_eq_zero.1 h
      rw [this] at hPdeg
      exact absurd (lt_of_lt_of_le hPdeg degree_C_le) (lt_irrefl _)
    have hroot : (P - C c).IsRoot y₀ := by simp [IsRoot, hPy₀]
    have hder : (derivative (P - C c)).IsRoot y₀ := by
      simp only [derivative_sub, derivative_C, sub_zero, IsRoot]; exact hcrit
    have h2 : 1 < rootMultiplicity y₀ (P - C c) :=
      (one_lt_rootMultiplicity_iff_isRoot hne).2 ⟨hroot, hder⟩
    obtain ⟨q, hq⟩ : (X - C y₀) ^ 2 ∣ P - C c :=
      (pow_dvd_pow _ h2).trans (pow_rootMultiplicity_dvd _ _)
    have hqe : ∀ y, P.eval y - c = (y - y₀) ^ 2 * q.eval y := fun y => by
      have := congrArg (eval y) hq
      simpa using this
    obtain ⟨S, hS⟩ := hEa
    set D := dslope E 0
    have hDa : AnalyticAt ℂ D 0 := ⟨_, hS.has_fpower_series_dslope_fslope⟩
    have hD0 : D 0 = 0 := by simp only [D, dslope_same]; exact hd0
    obtain ⟨S₂, hS₂⟩ := hDa
    set D₂ := dslope D 0
    have hD₂a : AnalyticAt ℂ D₂ 0 := ⟨_, hS₂.has_fpower_series_dslope_fslope⟩
    have hED : ∀ t, E t - y₀ = t ^ 2 * D₂ t := by
      intro t
      have h1 := sub_smul_dslope E 0 t
      have h2 := sub_smul_dslope D 0 t
      rw [smul_eq_mul, sub_zero] at h1 h2
      rw [hD0, sub_zero] at h2
      rw [← hE0, ← h1]
      show t * D t = t ^ 2 * D₂ t
      rw [← h2]; ring
    set g : ℂ → ℂ := fun t => t ^ (4 - m) * D₂ t ^ 2 * q.eval (E t)
    have hgc : ContinuousAt g 0 := by
      have hEc : ContinuousAt E 0 := hS.analyticAt.continuousAt
      exact ((continuous_pow _).continuousAt.mul (hD₂a.continuousAt.pow 2)).mul
        ((Polynomial.continuous q).continuousAt.comp hEc)
    have hg0 : g 0 = 0 := by simp only [g]; rw [zero_pow (by omega)]; ring
    have hg1 : ∀ᶠ t in 𝓝[≠] (0 : ℂ), g t = 1 := by
      filter_upwards [mem_nhdsWithin_of_mem_nhds (ball_mem_nhds 0 hr), self_mem_nhdsWithin]
        with t ht ht0
      have key : t ^ m = t ^ m * g t := by
        have e1 := hPE t ht
        have e2 := hqe (E t)
        rw [e1, hED] at e2
        have : t ^ m = t ^ 4 * D₂ t ^ 2 * q.eval (E t) := by linear_combination e2
        have h4 : t ^ 4 = t ^ m * t ^ (4 - m) := by
          rw [← pow_add]; congr 1; omega
        calc t ^ m = t ^ 4 * D₂ t ^ 2 * q.eval (E t) := this
          _ = t ^ m * g t := by rw [h4]; simp only [g]; ring
      have htm : t ^ m ≠ 0 := pow_ne_zero _ ht0
      have := mul_left_cancel₀ htm (key.symm.trans (mul_one _).symm)
      exact this
    have hlim : Tendsto g (𝓝[≠] (0 : ℂ)) (𝓝 0) := by
      have := hgc.tendsto
      rw [hg0] at this
      exact this.mono_left nhdsWithin_le_nhds
    have := tendsto_nhds_unique hlim (tendsto_const_nhds.congr' (EventuallyEq.symm hg1))
    exact zero_ne_one this
  refine ⟨?_, hd⟩
  -- Step 2: local injectivity of `E`
  obtain ⟨ρ₁, hρ₁, hEan⟩ := hEa.exists_ball_analyticOnNhd
  obtain ⟨ρ₂, hρ₂, hinj⟩ := HolInv.exists_ball_injOn isOpen_ball hEan.differentiableOn
    (mem_ball_self hρ₁) hd
  set ρ := min ρ₂ r
  have hρ : 0 < ρ := lt_min hρ₂ hr
  set t₀ : ℂ := ((ρ / 2 : ℝ) : ℂ)
  have ht₀n : ‖t₀‖ = ρ / 2 := by
    simp only [t₀, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (half_pos hρ)]
  have ht₀0 : t₀ ≠ 0 := by
    intro h; rw [h, norm_zero] at ht₀n; linarith
  have ht₀ρ : ‖t₀‖ < ρ := by rw [ht₀n]; linarith
  have ht₀r : t₀ ∈ ball (0 : ℂ) r :=
    mem_ball_zero_iff.2 (lt_of_lt_of_le ht₀ρ (min_le_right _ _))
  -- Step 3: every stabilizing element is trivial
  ext σ
  simp only [mem_stabIn, Subgroup.mem_bot]
  constructor
  · rintro ⟨hσH, hσw⟩
    have hσj := cuspAct_eq_of_fix hσw
    obtain ⟨ζ, hζ, hrot⟩ := rot_formula σ j hσj
    have hζn : ‖ζ‖ = 1 := norm_root_one (by omega) hζ
    have hζt₀ : ‖ζ * t₀‖ < ρ := by rw [norm_mul, hζn, one_mul]; exact ht₀ρ
    have hEeq : E (ζ * t₀) = E t₀ := by
      show Ev (χ.symm (ζ * t₀)) = Ev (χ.symm t₀)
      rw [← hrot t₀ ht₀r, Ev_inv hfib hσH]
    have hmem1 : ζ * t₀ ∈ ball (0 : ℂ) ρ₂ :=
      mem_ball_zero_iff.2 (lt_of_lt_of_le hζt₀ (min_le_left _ _))
    have hmem2 : t₀ ∈ ball (0 : ℂ) ρ₂ :=
      mem_ball_zero_iff.2 (lt_of_lt_of_le ht₀ρ (min_le_left _ _))
    have hzt : ζ * t₀ = t₀ := hinj hmem1 hmem2 hEeq
    have hζ1 : ζ = 1 := by
      have : (ζ - 1) * t₀ = 0 := by linear_combination hzt
      exact sub_eq_zero.1 ((mul_eq_zero.1 this).resolve_right ht₀0)
    have hfix : regFillAct hs f₀ σ (χ.symm t₀) = regFillAct hs f₀ 1 (χ.symm t₀) := by
      rw [hrot t₀ ht₀r, hζ1, one_mul, regFillAct_one]; rfl
    obtain ⟨g0, g1⟩ := cusp_symm_generic j ht₀r ht₀0
    exact eq_of_act_eq g0 g1 hfix
  · rintro rfl
    exact ⟨H.one_mem, by rw [regFillAct_one]; rfl⟩

/-- **At a regular point of `P` over a branch value the stabilizer has the full order `dB`**, and
it contains an element acting by the primitive rotation `t ↦ exp(2πi/dB) t` in the cusp chart. -/
theorem stab_card_noncrit
    (hEv : haveI := (regFill_riemannSurface hs f₀).2.1; ContMDiff 𝓘(ℂ) 𝓘(ℂ) ω Ev)
    (hPEv : ∀ w, P.eval (Ev w) = regFillProj hs f₀ w)
    (hfib : ∀ w w', Ev w = Ev w' ↔ ∃ σ ∈ H, regFillAct hs f₀ σ w = w')
    (j : BIdx (regProj f₀) cB (1 / 2)) (hreg : P.derivative.eval (Ev (Fill.cusp j)) ≠ 0) :
    Nat.card (stabIn H (Fill.cusp j : RegFill hs f₀)) = dB j.1 ∧
      ∃ σ ∈ stabIn H (Fill.cusp j : RegFill hs f₀), ∀ t ∈ ball (0 : ℂ) ((regEnds hs f₀).r j),
        regFillAct hs f₀ σ ((Fill.cuspChart (E := regEnds hs f₀) j).symm t) =
          (Fill.cuspChart (E := regEnds hs f₀) j).symm
            (Complex.exp (2 * Real.pi * Complex.I / (dB j.1 : ℂ)) * t) := by
  haveI := (regFill_riemannSurface hs f₀).2.1
  set χ := Fill.cuspChart (E := regEnds hs f₀) j
  set r := (regEnds hs f₀).r j
  have hr : 0 < r := (regEnds hs f₀).r_pos j
  set m := dB j.1
  set c := cB j.1
  have hm := dB_le_three j.1
  set E : ℂ → ℂ := fun t => Ev (χ.symm t)
  set y₀ := Ev (Fill.cusp j)
  have hE0 : E 0 = y₀ := by
    show Ev (χ.symm 0) = y₀
    rw [cuspChart_symm_zero]
  have hEa : AnalyticAt ℂ E 0 :=
    analyticAt_chart_fun hEv (cuspChart_mem_atlas j) (mem_ball_self hr)
  have hPE : ∀ t ∈ ball (0 : ℂ) r, P.eval (E t) = c + t ^ m := fun t ht => eval_E_cusp hPEv j ht
  have hP' : deriv (fun y => P.eval y) y₀ ≠ 0 := by rw [Polynomial.deriv]; exact hreg
  obtain ⟨ρP, hρP, hPinj⟩ := HolInv.exists_ball_injOn isOpen_univ
    (Polynomial.differentiable P).differentiableOn (mem_univ y₀) hP'
  obtain ⟨δ₁, hδ₁, hδ₁E⟩ := Metric.eventually_nhds_iff_ball.1
    (hEa.continuousAt.eventually (ball_mem_nhds (E 0) hρP))
  set δ := min δ₁ r
  have hδ : 0 < δ := lt_min hδ₁ hr
  set t₀ : ℂ := ((δ / 2 : ℝ) : ℂ)
  have ht₀n : ‖t₀‖ = δ / 2 := by
    simp only [t₀, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (half_pos hδ)]
  have ht₀0 : t₀ ≠ 0 := by
    intro h; rw [h, norm_zero] at ht₀n; linarith
  set ζ₀ := Complex.exp (2 * Real.pi * Complex.I / (m : ℂ))
  have hprim : IsPrimitiveRoot ζ₀ m := Complex.isPrimitiveRoot_exp m (by omega)
  have hζ₀m : ζ₀ ^ m = 1 := hprim.pow_eq_one
  have hζ₀n : ‖ζ₀‖ = 1 := hprim.norm'_eq_one (by omega)
  have hnorm_pow : ∀ (k : ℕ) (t : ℂ), ‖ζ₀ ^ k * t‖ = ‖t‖ := fun k t => by
    rw [norm_mul, norm_pow, hζ₀n, one_pow, one_mul]
  have hinδ : ∀ t : ℂ, ‖t‖ < δ → t ∈ ball (0 : ℂ) δ₁ ∧ t ∈ ball (0 : ℂ) r := fun t ht =>
    ⟨mem_ball_zero_iff.2 (lt_of_lt_of_le ht (min_le_left _ _)),
      mem_ball_zero_iff.2 (lt_of_lt_of_le ht (min_le_right _ _))⟩
  have ht₀δ : ‖t₀‖ < δ := by rw [ht₀n]; linarith
  have hζt₀δ : ‖ζ₀ * t₀‖ < δ := by rw [norm_mul, hζ₀n, one_mul]; exact ht₀δ
  obtain ⟨ht₀1, ht₀r⟩ := hinδ t₀ ht₀δ
  obtain ⟨hζt₀1, hζt₀r⟩ := hinδ (ζ₀ * t₀) hζt₀δ
  have hEeq : E t₀ = E (ζ₀ * t₀) := by
    refine hPinj ?_ ?_ ?_
    · have := hδ₁E t₀ ht₀1; rwa [hE0] at this
    · have := hδ₁E _ hζt₀1; rwa [hE0] at this
    · show P.eval (E t₀) = P.eval (E (ζ₀ * t₀))
      rw [hPE t₀ ht₀r, hPE _ hζt₀r, mul_pow, hζ₀m, one_mul]
  obtain ⟨σ, hσH, hσ⟩ := (hfib (χ.symm t₀) (χ.symm (ζ₀ * t₀))).1 hEeq
  have hp : t₀ ∈ pdisk r := ⟨ht₀0, mem_ball_zero_iff.1 ht₀r⟩
  have hp' : ζ₀ * t₀ ∈ pdisk r :=
    ⟨mul_ne_zero (by rintro h; rw [h, norm_zero] at hζ₀n; exact zero_ne_one hζ₀n) ht₀0,
      mem_ball_zero_iff.1 hζt₀r⟩
  have hσj : cuspAct hs f₀ σ j = j := by
    by_contra hne
    have e1 : χ.symm t₀ = Fill.inl (((regEnds hs f₀).Φ j).symm ⟨t₀, hp⟩ : RegCov f₀) :=
      Fill.cuspInv_of_mem (E := regEnds hs f₀) hp
    have e2 : χ.symm (ζ₀ * t₀) =
        Fill.inl (((regEnds hs f₀).Φ j).symm ⟨ζ₀ * t₀, hp'⟩ : RegCov f₀) :=
      Fill.cuspInv_of_mem (E := regEnds hs f₀) hp'
    rw [e1, e2] at hσ
    set y := ((regEnds hs f₀).Φ j).symm ⟨t₀, hp⟩
    set y' := ((regEnds hs f₀).Φ j).symm ⟨ζ₀ * t₀, hp'⟩
    have hσ' : regAct f₀ σ y.1 = y'.1 := Fill.inl_injective hσ
    obtain ⟨hy, -⟩ := endCompat_regAct hs f₀ σ j y.1 y.2
    rw [hσ'] at hy
    exact Set.disjoint_left.1 ((regEnds hs f₀).disj hne) hy y'.2
  have hσS : σ ∈ stabIn H (Fill.cusp j : RegFill hs f₀) := ⟨hσH, by rw [cusp_act, hσj]⟩
  obtain ⟨ζ, hζ, hrot⟩ := rot_formula σ j hσj
  have hζeq : ζ = ζ₀ := by
    have h1 := hrot t₀ ht₀r
    rw [hσ] at h1
    have hmem1 : ζ₀ * t₀ ∈ χ.symm.source := hζt₀r
    have hζn : ‖ζ‖ = 1 := norm_root_one (by omega) hζ
    have hmem2 : ζ * t₀ ∈ χ.symm.source := by
      show ζ * t₀ ∈ ball (0 : ℂ) r
      rw [mem_ball_zero_iff, norm_mul, hζn, one_mul]; exact mem_ball_zero_iff.1 ht₀r
    have h2 := χ.symm.injOn hmem1 hmem2 h1
    exact (mul_right_cancel₀ ht₀0 h2).symm
  rw [hζeq] at hrot
  have hpow : ∀ k : ℕ, ∀ t ∈ ball (0 : ℂ) r,
      regFillAct hs f₀ (σ ^ k) (χ.symm t) = χ.symm (ζ₀ ^ k * t) := by
    intro k
    induction k with
    | zero => intro t _; rw [pow_zero, pow_zero, one_mul, regFillAct_one]; rfl
    | succ k ih =>
      intro t ht
      have hk : ζ₀ ^ k * t ∈ ball (0 : ℂ) r := by
        rw [mem_ball_zero_iff, hnorm_pow]; exact mem_ball_zero_iff.1 ht
      rw [pow_succ, regFillAct_mul, Function.comp_apply, ih t ht, hrot _ hk, pow_succ]
      congr 1; ring
  have hlow : m ≤ Nat.card (stabIn H (Fill.cusp j : RegFill hs f₀)) := by
    let f : Fin m → stabIn H (Fill.cusp j : RegFill hs f₀) := fun k =>
      ⟨σ ^ (k : ℕ), Subgroup.pow_mem _ hσS _⟩
    have hf : Function.Injective f := by
      intro k l hkl
      have h1 : σ ^ (k : ℕ) = σ ^ (l : ℕ) := congrArg Subtype.val hkl
      have h2 := congrArg (fun g => regFillAct hs f₀ g (χ.symm t₀)) h1
      simp only at h2
      rw [hpow k t₀ ht₀r, hpow l t₀ ht₀r] at h2
      have hk : ζ₀ ^ (k : ℕ) * t₀ ∈ χ.symm.source := by
        show _ ∈ ball (0 : ℂ) r
        rw [mem_ball_zero_iff, hnorm_pow]; exact mem_ball_zero_iff.1 ht₀r
      have hl : ζ₀ ^ (l : ℕ) * t₀ ∈ χ.symm.source := by
        show _ ∈ ball (0 : ℂ) r
        rw [mem_ball_zero_iff, hnorm_pow]; exact mem_ball_zero_iff.1 ht₀r
      have h3 := χ.symm.injOn hk hl h2
      exact Fin.ext (hprim.pow_inj k.2 l.2 (mul_right_cancel₀ ht₀0 h3))
    have := Nat.card_le_card_of_injective f hf
    simpa using this
  have hup : Nat.card (stabIn H (Fill.cusp j : RegFill hs f₀)) ≤ m := by
    have hrotS : ∀ τ : stabIn H (Fill.cusp j : RegFill hs f₀), ∃ ζ : ℂ, ζ ^ m = 1 ∧
        ∀ t ∈ ball (0 : ℂ) r, regFillAct hs f₀ τ.1 (χ.symm t) = χ.symm (ζ * t) :=
      fun τ => rot_formula τ.1 j (cuspAct_eq_of_fix τ.2.2)
    choose ρf hρf hρrot using hrotS
    let g : stabIn H (Fill.cusp j : RegFill hs f₀) → (nthRootsFinset m (1 : ℂ)) := fun τ =>
      ⟨ρf τ, (mem_nthRootsFinset (by omega) 1).2 (hρf τ)⟩
    have hg : Function.Injective g := by
      intro τ₁ τ₂ h
      have h1 : ρf τ₁ = ρf τ₂ := congrArg Subtype.val h
      have h2 : regFillAct hs f₀ τ₁.1 (χ.symm t₀) = regFillAct hs f₀ τ₂.1 (χ.symm t₀) := by
        rw [hρrot τ₁ t₀ ht₀r, hρrot τ₂ t₀ ht₀r, h1]
      obtain ⟨g0, g1⟩ := cusp_symm_generic j ht₀r ht₀0
      exact Subtype.ext (eq_of_act_eq g0 g1 h2)
    have := Nat.card_le_card_of_injective g hg
    rwa [Nat.card_eq_fintype_card (α := ↥(nthRootsFinset m (1 : ℂ))), Fintype.card_coe,
      hprim.card_nthRootsFinset] at this
  exact ⟨le_antisymm hup hlow, σ, hσS, hrot⟩

/-- **The local quotient power map.**  At a regular point of `P` over a branch value, the quotient
coordinate `Ev` reads, in the cusp chart, `t ↦ G(cB + t^dB)` with `G` a local inverse of `P`
(holomorphic, `G' ≠ 0`). -/
theorem local_power_map
    (hEv : haveI := (regFill_riemannSurface hs f₀).2.1; ContMDiff 𝓘(ℂ) 𝓘(ℂ) ω Ev)
    (hPEv : ∀ w, P.eval (Ev w) = regFillProj hs f₀ w)
    (j : BIdx (regProj f₀) cB (1 / 2)) (hreg : P.derivative.eval (Ev (Fill.cusp j)) ≠ 0) :
    ∃ ρ > 0, ∃ G : ℂ → ℂ, AnalyticAt ℂ G (cB j.1) ∧ deriv G (cB j.1) ≠ 0 ∧
      G (cB j.1) = Ev (Fill.cusp j) ∧ ∀ t ∈ ball (0 : ℂ) ρ,
        Ev ((Fill.cuspChart (E := regEnds hs f₀) j).symm t) = G (cB j.1 + t ^ (dB j.1)) := by
  haveI := (regFill_riemannSurface hs f₀).2.1
  set χ := Fill.cuspChart (E := regEnds hs f₀) j
  set r := (regEnds hs f₀).r j
  have hr : 0 < r := (regEnds hs f₀).r_pos j
  have hm := dB_le_three j.1
  set E : ℂ → ℂ := fun t => Ev (χ.symm t)
  set y₀ := Ev (Fill.cusp j)
  have hE0 : E 0 = y₀ := by
    show Ev (χ.symm 0) = y₀
    rw [cuspChart_symm_zero]
  have hEa : AnalyticAt ℂ E 0 :=
    analyticAt_chart_fun hEv (cuspChart_mem_atlas j) (mem_ball_self hr)
  have hPE : ∀ t ∈ ball (0 : ℂ) r, P.eval (E t) = cB j.1 + t ^ (dB j.1) :=
    fun t ht => eval_E_cusp hPEv j ht
  have hPy₀ : P.eval y₀ = cB j.1 := by
    have := hPE 0 (mem_ball_self hr)
    rwa [hE0, zero_pow (by omega), add_zero] at this
  have hP' : deriv (fun y => P.eval y) y₀ ≠ 0 := by rw [Polynomial.deriv]; exact hreg
  have hdc : ContinuousAt (fun y => P.derivative.eval y) y₀ :=
    (Polynomial.continuous _).continuousAt
  obtain ⟨ρ₁, hρ₁, hinj⟩ := HolInv.exists_ball_injOn isOpen_univ
    (Polynomial.differentiable P).differentiableOn (mem_univ y₀) hP'
  obtain ⟨ρ₂, hρ₂, hρ₂d⟩ := Metric.eventually_nhds_iff_ball.1
    (hdc.eventually (isOpen_ne.mem_nhds hreg))
  set ρP := min ρ₁ ρ₂
  have hρP : 0 < ρP := lt_min hρ₁ hρ₂
  set Y := ball y₀ ρP
  have hYinj : InjOn (fun y => P.eval y) Y := hinj.mono (ball_subset_ball (min_le_left _ _))
  set G := Function.invFunOn (fun y => P.eval y) Y
  have hWo : IsOpen ((fun y => P.eval y) '' Y) :=
    HolInv.isOpen_image (Polynomial.differentiable P).differentiableOn hYinj subset_rfl isOpen_ball
  have hGd : DifferentiableOn ℂ G ((fun y => P.eval y) '' Y) := by
    rintro _ ⟨y, hy, rfl⟩
    have hd : deriv (fun y => P.eval y) y ≠ 0 := by
      rw [Polynomial.deriv]; exact hρ₂d y (ball_subset_ball (min_le_right _ _) hy)
    exact (HolInv.hasDerivAt_invFunOn isOpen_ball (Polynomial.differentiable P).differentiableOn
      hYinj hy hd).differentiableAt.differentiableWithinAt
  have hcW : cB j.1 ∈ (fun y => P.eval y) '' Y := ⟨y₀, mem_ball_self hρP, hPy₀⟩
  have hGc : G (cB j.1) = y₀ := by
    rw [← hPy₀]; exact HolInv.invFunOn_apply_self hYinj (mem_ball_self hρP)
  have hGder : HasDerivAt G (deriv (fun y => P.eval y) y₀)⁻¹ (cB j.1) := by
    have := HolInv.hasDerivAt_invFunOn isOpen_ball (Polynomial.differentiable P).differentiableOn
      hYinj (mem_ball_self hρP) hP'
    rwa [hPy₀] at this
  obtain ⟨δ₁, hδ₁, hδ₁E⟩ := Metric.eventually_nhds_iff_ball.1
    (hEa.continuousAt.eventually (ball_mem_nhds (E 0) hρP))
  refine ⟨min δ₁ r, lt_min hδ₁ hr, G, hGd.analyticAt (hWo.mem_nhds hcW), ?_, hGc, fun t ht => ?_⟩
  · rw [hGder.deriv]; exact inv_ne_zero hP'
  · have ht1 : t ∈ ball (0 : ℂ) δ₁ := ball_subset_ball (min_le_left _ _) ht
    have ht2 : t ∈ ball (0 : ℂ) r := ball_subset_ball (min_le_right _ _) ht
    have hEt : E t ∈ Y := by have := hδ₁E t ht1; rwa [hE0] at this
    show E t = G (cB j.1 + t ^ (dB j.1))
    rw [← hPE t ht2]
    exact (HolInv.invFunOn_apply_self hYinj hEt).symm

end Degree7
