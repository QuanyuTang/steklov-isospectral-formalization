Degree7.prop_3_3_1_full {s : ℂ} (hs : s ^ 2 = -7) :
  ∃ f₀,
    PathConnectedSpace ↑(SteklovRegularCover.RegCov f₀) ∧
      ConnectedSpace (Degree7.RegFill hs f₀) ∧
        (∀ (σ : ↥(SteklovRegularCover.deckGroup f₀)),
            ContMDiff (modelWithCornersSelf ℂ ℂ) (modelWithCornersSelf ℂ ℂ) ⊤ (Degree7.regFillAct hs f₀ σ) ∧
              Function.Bijective (Degree7.regFillAct hs f₀ σ) ∧
                ∀ (w : Degree7.RegFill hs f₀),
                  Degree7.regFillProj hs f₀ (Degree7.regFillAct hs f₀ σ w) = Degree7.regFillProj hs f₀ w) ∧
          Degree7.regFillAct hs f₀ 1 = id ∧
            (∀ (σ τ : ↥(SteklovRegularCover.deckGroup f₀)),
                Degree7.regFillAct hs f₀ (σ * τ) = Degree7.regFillAct hs f₀ τ ∘ Degree7.regFillAct hs f₀ σ) ∧
              Nat.card ↥(SteklovRegularCover.deckGroup f₀) = 168 ∧
                (∃ ι a b,
                    (∀ (g : GL3F2.G), ↑(ι g) = (Degree7.combRho Degree7.rhoP Degree7.rhoL) g) ∧
                        Degree7.stabSub f₀ 0 =
                            Subgroup.map ι.toMonoidHom (Subgroup.map (MulEquiv.toMonoidHom (MulAut.conj a)) GL3F2.HP) ∧
                          Degree7.stabSub f₀ 7 =
                            Subgroup.map ι.toMonoidHom (Subgroup.map (MulEquiv.toMonoidHom (MulAut.conj b)) GL3F2.HL) ∨
                      (∀ (g : GL3F2.G), ↑(ι g) = (Degree7.combRho Degree7.rhoL Degree7.rhoP) g) ∧
                        Degree7.stabSub f₀ 0 =
                            Subgroup.map ι.toMonoidHom (Subgroup.map (MulEquiv.toMonoidHom (MulAut.conj a)) GL3F2.HL) ∧
                          Degree7.stabSub f₀ 7 =
                            Subgroup.map ι.toMonoidHom (Subgroup.map (MulEquiv.toMonoidHom (MulAut.conj b)) GL3F2.HP)) ∧
                  ∃ Ev₁ Ev₂,
                    ContMDiff (modelWithCornersSelf ℂ ℂ) (modelWithCornersSelf ℂ ℂ) ⊤ Ev₁ ∧
                      ContMDiff (modelWithCornersSelf ℂ ℂ) (modelWithCornersSelf ℂ ℂ) ⊤ Ev₂ ∧
                        (∀ (w : Degree7.RegFill hs f₀),
                            Polynomial.eval (Ev₁ w) (Degree7.pPoly s) = Degree7.regFillProj hs f₀ w) ∧
                          (∀ (w : Degree7.RegFill hs f₀),
                              Polynomial.eval (Ev₂ w) (Degree7.pPoly (-s)) = Degree7.regFillProj hs f₀ w) ∧
                            (∀ (w w' : Degree7.RegFill hs f₀),
                                Ev₁ w = Ev₁ w' ↔ (Degree7.orbSetoid hs f₀ (Degree7.stabSub f₀ 0)) w w') ∧
                              (∀ (w w' : Degree7.RegFill hs f₀),
                                  Ev₂ w = Ev₂ w' ↔ (Degree7.orbSetoid hs f₀ (Degree7.stabSub f₀ 7)) w w') ∧
                                (∀ (ε : ℝ),
                                    0 < ε →
                                      ε < 1 / 3 →
                                        IsCompact (Degree7.bordered hs f₀ ε) ∧
                                          IsClosed (Degree7.bordered hs f₀ ε) ∧
                                            interior (Degree7.bordered hs f₀ ε) = {w | ‖Degree7.bdf hs f₀ ε w‖ < 1} ∧
                                              frontier (Degree7.bordered hs f₀ ε) = Degree7.borderedBdry hs f₀ ε ∧
                                                closure (interior (Degree7.bordered hs f₀ ε)) =
                                                    Degree7.bordered hs f₀ ε ∧
                                                  (∀ w ∈ Degree7.borderedBdry hs f₀ ε,
                                                      ∃ φ,
                                                        w ∈ φ.source ∧
                                                          Set.EqOn (↑φ) (Degree7.bdf hs f₀ ε) φ.source ∧
                                                            ↑φ '' (φ.source ∩ Degree7.bordered hs f₀ ε) =
                                                                φ.target ∩ Metric.closedBall 0 1 ∧
                                                              ↑φ '' (φ.source ∩ Degree7.borderedBdry hs f₀ ε) =
                                                                  φ.target ∩ Metric.sphere 0 1 ∧
                                                                ContMDiffOn (modelWithCornersSelf ℂ ℂ)
                                                                    (modelWithCornersSelf ℂ ℂ) ⊤ (↑φ) φ.source ∧
                                                                  ContMDiffOn (modelWithCornersSelf ℂ ℂ)
                                                                    (modelWithCornersSelf ℂ ℂ) ⊤ (↑φ.symm) φ.target) ∧
                                                    (∀ (σ : ↥(SteklovRegularCover.deckGroup f₀))
                                                        (w : Degree7.RegFill hs f₀),
                                                        Degree7.regFillAct hs f₀ σ w ∈ Degree7.bordered hs f₀ ε ↔
                                                          w ∈ Degree7.bordered hs f₀ ε) ∧
                                                      IsConnected (Degree7.bordered hs f₀ ε) ∧
                                                        IsConnected (interior (Degree7.bordered hs f₀ ε)) ∧
                                                          ∀
                                                            (L :
                                                              SteklovOrb.BaseOrbMetric (↑ε)
                                                                (SteklovCritical.lamStar * ↑ε) 2 3),
                                                            Degree7.bordered hs f₀ ε ⊆ Degree7.bdf hs f₀ ε ⁻¹' L.U ∧
                                                              (∀ e ∈ atlas ℂ (Degree7.RegFill hs f₀),
                                                                  ∀ z ∈ Degree7.chartDom L e,
                                                                    ContDiffAt ℝ (↑⊤) (Degree7.regMetric L e) z ∧
                                                                      0 < Degree7.regMetric L e z) ∧
                                                                (∀ e ∈ atlas ℂ (Degree7.RegFill hs f₀),
                                                                    ∀ z ∈ Degree7.chartDom L e,
                                                                      Degree7.bdf hs f₀ ε (↑e.symm z) ≠ ↑ε →
                                                                        Degree7.bdf hs f₀ ε (↑e.symm z) ≠
                                                                            SteklovCritical.lamStar * ↑ε →
                                                                          Degree7.regMetric L e z =
                                                                            L.lam (Degree7.bdf hs f₀ ε (↑e.symm z)) *
                                                                              ‖deriv (Degree7.bdf hs f₀ ε ∘ ↑e.symm)
                                                                                    z‖ ^
                                                                                2) ∧
                                                                  (∀ e ∈ atlas ℂ (Degree7.RegFill hs f₀),
                                                                      ∀ e' ∈ atlas ℂ (Degree7.RegFill hs f₀),
                                                                        ∀ z ∈ Degree7.chartDom L e,
                                                                          ↑e.symm z ∈ e'.source →
                                                                            AnalyticAt ℂ (↑e' ∘ ↑e.symm) z ∧
                                                                              Degree7.regMetric L e z =
                                                                                Degree7.regMetric L e'
                                                                                    ((↑e' ∘ ↑e.symm) z) *
                                                                                  ‖deriv (↑e' ∘ ↑e.symm) z‖ ^ 2) ∧
                                                                    ∀ (σ : ↥(SteklovRegularCover.deckGroup f₀)),
                                                                      ∀ e ∈ atlas ℂ (Degree7.RegFill hs f₀),
                                                                        ∀ e' ∈ atlas ℂ (Degree7.RegFill hs f₀),
                                                                          ∀ z ∈ Degree7.chartDom L e,
                                                                            Degree7.regFillAct hs f₀ σ (↑e.symm z) ∈
                                                                                e'.source →
                                                                              AnalyticAt ℂ
                                                                                  (↑e' ∘
                                                                                    Degree7.regFillAct hs f₀ σ ∘
                                                                                      ↑e.symm)
                                                                                  z ∧
                                                                                (↑e' ∘
                                                                                        Degree7.regFillAct hs f₀ σ ∘
                                                                                          ↑e.symm)
                                                                                      z ∈
                                                                                    Degree7.chartDom L e' ∧
                                                                                  Degree7.regMetric L e z =
                                                                                    Degree7.regMetric L e'
                                                                                        ((↑e' ∘
                                                                                            Degree7.regFillAct hs f₀ σ ∘
                                                                                              ↑e.symm)
                                                                                          z) *
                                                                                      ‖deriv
                                                                                            (↑e' ∘
                                                                                              Degree7.regFillAct hs f₀
                                                                                                  σ ∘
                                                                                                ⋯)
                                                                                            z‖ ^
                                                                                        2) ∧
                                  ∀ (aP aL : ℂ),
                                    aP ^ 7 = -Degree7.bconst s →
                                      aL ^ 7 = -Degree7.bconst (-s) →
                                        ∀ (τ : ℝ → ℂ),
                                          (∀ (ε : ℝ), τ ε ^ 7 = (SteklovCritical.lamStar - 1) * ↑ε) →
                                            ∀ᶠ (ε : ℝ) in nhdsWithin 0 (Set.Ioi 0),
                                              ∀ (ψP BP ψL BL : ℂ → ℂ),
                                                SteklovCoalescence.IsNormalizedDiskCover
                                                    (SteklovCoalescence.paperQ (Degree7.monicP s aP) τ ε) 7 ψP BP →
                                                  SteklovCoalescence.IsNormalizedDiskCover
                                                      (SteklovCoalescence.paperQ (Degree7.monicP (-s) aL) τ ε) 7 ψL BL →
                                                    ∀
                                                      (L :
                                                        SteklovOrb.BaseOrbMetric (↑ε) (SteklovCritical.lamStar * ↑ε) 2
                                                          3),
                                                      ∃ VP VL,
                                                        ∃ (hP :
                                                          SteklovOrb.IsBranchedDiskMap BP VP (↑ε)
                                                            (SteklovCritical.lamStar * ↑ε) 2 3 L.U)
                                                          (hL :
                                                          SteklovOrb.IsBranchedDiskMap BL VL (↑ε)
                                                            (SteklovCritical.lamStar * ↑ε) 2 3 L.U),
                                                          (Degree7.LabelGeometry hs f₀ (Degree7.stabSub f₀ 0)
                                                                (Degree7.pPoly s) Ev₁ ε (τ ε / aP) ψP BP L hP ∧
                                                              Degree7.CuspCompat hs f₀ (Degree7.stabSub f₀ 0)
                                                                (Degree7.pPoly s) Ev₁ ε (τ ε / aP) ψP BP L hP) ∧
                                                            (Degree7.LabelGeometry hs f₀ (Degree7.stabSub f₀ 7)
                                                                  (Degree7.pPoly (-s)) Ev₂ ε (τ ε / aL) ψL BL L hL ∧
                                                                Degree7.CuspCompat hs f₀ (Degree7.stabSub f₀ 7)
                                                                  (Degree7.pPoly (-s)) Ev₂ ε (τ ε / aL) ψL BL L hL) ∧
                                                              (SteklovOrb.pullbackOrb L hP).metricSteklovEigenvalue =
                                                                  (SteklovOrb.pullbackOrb L
                                                                      hL).metricSteklovEigenvalue ∧
                                                                (SteklovOrb.pullbackOrb L hP).steklovSpectrum =
                                                                  (SteklovOrb.pullbackOrb L hL).steklovSpectrum
