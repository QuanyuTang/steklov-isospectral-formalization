SteklovBlaschke.blaschke_boundary_rigidity {B₁ B₂ φ : ℂ → ℂ} {n m : ℕ} (hB₁ : SteklovBlaschke.IsFiniteBlaschke B₁ n)
  (hB₂ : SteklovBlaschke.IsFiniteBlaschke B₂ m) (hφ : SteklovBlaschke.IsDiskAut φ)
  (h :
    ∀ (t : ℝ),
      ‖deriv (fun s => B₁ (Complex.exp (↑s * Complex.I))) t‖ =
        ‖deriv (fun s => B₂ (φ (Complex.exp (↑s * Complex.I)))) t‖) :
  ∃ η, ‖η‖ = 1 ∧ ∀ (z : ℂ), ‖z‖ ≤ 1 → B₁ z = η * B₂ (φ z)
SteklovBlaschke.blaschke_boundary_rigidity_anti {B₁ B₂ φ : ℂ → ℂ} {n m : ℕ}
  (hB₁ : SteklovBlaschke.IsFiniteBlaschke B₁ n) (hB₂ : SteklovBlaschke.IsFiniteBlaschke B₂ m)
  (hφ : SteklovBlaschke.IsAntiDiskAut φ)
  (h :
    ∀ (t : ℝ),
      ‖deriv (fun s => B₁ (Complex.exp (↑s * Complex.I))) t‖ =
        ‖deriv (fun s => B₂ (φ (Complex.exp (↑s * Complex.I)))) t‖) :
  ∃ η, ‖η‖ = 1 ∧ ∀ (z : ℂ), ‖z‖ ≤ 1 → B₁ z = η * (starRingEnd ℂ) (B₂ (φ z))
group_input :
  ∃ G x,
    ∃ (x_1 : Finite G),
      ∃ H₁ H₂ n x_2 y,
        H₁.index = n ∧
          H₂.index = n ∧
            SteklovGroup.AlmostConjugate H₁ H₂ ∧
              ¬SteklovGroup.AreConjugate H₁ H₂ ∧
                Subgroup.closure {x_2, y} = ⊤ ∧
                  SteklovGroup.cycleCount (x_2 * y) (G ⧸ H₁) = 1 ∧
                    SteklovGroup.cycleCount x_2 (G ⧸ H₁) + SteklovGroup.cycleCount y (G ⧸ H₁) = n + 1 ∧
                      SteklovGroup.cycleCount x_2 (G ⧸ H₁) < n ∧ SteklovGroup.cycleCount y (G ⧸ H₁) < n
GL3F2.group_input_GL :
  ∃ H₁ H₂ x y,
    H₁.index = 7 ∧
      H₂.index = 7 ∧
        SteklovGroup.AlmostConjugate H₁ H₂ ∧
          ¬SteklovGroup.AreConjugate H₁ H₂ ∧
            Subgroup.closure {x, y} = ⊤ ∧
              SteklovGroup.cycleCount (x * y) (GL3F2.G ⧸ H₁) = 1 ∧
                SteklovGroup.cycleCount x (GL3F2.G ⧸ H₁) + SteklovGroup.cycleCount y (GL3F2.G ⧸ H₁) = 7 + 1 ∧
                  SteklovGroup.cycleCount x (GL3F2.G ⧸ H₁) < 7 ∧
                    SteklovGroup.cycleCount y (GL3F2.G ⧸ H₁) < 7 ∧ orderOf x = 2 ∧ orderOf y = 3 ∧ orderOf (x * y) = 7
SteklovDiskCovers.lemma_3_2_1 {p : Polynomial ℂ} (hp : p.Monic) (hcv : p.critVals = {0, 1}) :
  ∀ᶠ (ε : ℝ) in nhdsWithin 0 (Set.Ioi 0),
    PlaneDomain.IsDomain (SteklovDiskCovers.coverDomain p ε) ∧
      Bornology.IsBounded (SteklovDiskCovers.coverDomain p ε) ∧
        SimplyConnectedSpace ↑(SteklovDiskCovers.coverDomain p ε) ∧
          PlaneDomain.IsRealAnalyticJordanBoundary (SteklovDiskCovers.coverDomain p ε) ∧
            (Differentiable ℂ fun z => Polynomial.eval z (SteklovDiskCovers.coverPoly p ε)) ∧
              Set.MapsTo (fun z => Polynomial.eval z (SteklovDiskCovers.coverPoly p ε))
                  (SteklovDiskCovers.coverDomain p ε) (Metric.ball 0 1) ∧
                (∀ K ⊆ Metric.ball 0 1,
                    IsCompact K →
                      IsCompact
                        (SteklovDiskCovers.coverDomain p ε ∩
                          (fun z => Polynomial.eval z (SteklovDiskCovers.coverPoly p ε)) ⁻¹' K)) ∧
                  (∀ w ∈ Metric.ball 0 1,
                      (SteklovDiskCovers.coverPoly p ε - Polynomial.C w).roots.card = p.natDegree ∧
                        ∀ z ∈ (SteklovDiskCovers.coverPoly p ε - Polynomial.C w).roots,
                          z ∈ SteklovDiskCovers.coverDomain p ε) ∧
                    (∀ w ∈ Metric.ball 0 1,
                        w ∉ {↑ε, SteklovCritical.lamStar * ↑ε} →
                          Nat.card
                              { z //
                                z ∈ SteklovDiskCovers.coverDomain p ε ∧
                                  Polynomial.eval z (SteklovDiskCovers.coverPoly p ε) = w } =
                            p.natDegree) ∧
                      (fun z => Polynomial.eval z (SteklovDiskCovers.coverPoly p ε)) ''
                          {z |
                            z ∈ SteklovDiskCovers.coverDomain p ε ∧
                              Polynomial.eval z (Polynomial.derivative (SteklovDiskCovers.coverPoly p ε)) = 0} =
                        {↑ε, SteklovCritical.lamStar * ↑ε}
SteklovCoalescence.prop_3_4_1_unconditional {P : Polynomial ℂ} (hP : P.Monic) {n : ℕ} (hn : 1 ≤ n)
  (hdeg : P.natDegree = n) {τ : ℝ → ℂ} (hτ : ∀ (ε : ℝ), τ ε ^ n = (SteklovCritical.lamStar - 1) * ↑ε) :
  ∃ ψ B,
    (∀ᶠ (ε : ℝ) in nhdsWithin 0 (Set.Ioi 0),
        SteklovCoalescence.IsNormalizedDiskCover (SteklovCoalescence.paperQ P τ ε) n (ψ ε) (B ε)) ∧
      SteklovCoalescence.CoalescenceConclusions (nhdsWithin 0 (Set.Ioi 0)) n ψ B
