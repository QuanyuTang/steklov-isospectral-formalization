module

public import RequestProject.CoverInequivalence

/-!
# The standard loops generate the fundamental group of `ℂ \ {0, 1}`

Let `P` be a polynomial with `critVals P = {0, 1}` and let `γ₀, γ₁` be the standard generators at
`-r` (`IsStdLoops`, `0 < r < 1/2`).  We prove that **every** homotopy class of loops at `-r` in
`ℂ \ {0,1}` lies in the subgroup generated by `γ₀, γ₁` (`isStdLoops_generate`).

The proof is the classical subdivision argument.  `ℂ \ {0,1}` is covered by three open star-shaped
sets `O₁ = ℂ \ ((-∞,0] ∪ [1,∞))`, `O₂ = ℂ \ [0,∞)`, `O₃ = ℂ \ (-∞,1]` (centres `r`, `-r`, `1+r`).
Each point `x` is joined to the base point by a canonical class `c(x)` (through `i` if
`Im x ≥ 0`, through `-i` otherwise).  For a path `p` inside one `Oⱼ`, the loop `c(x) · p · c(y)⁻¹`
is one of four explicit loops, which are computed (`γ₀⁻¹`, trivial, `γ₁⁻¹ γ₀⁻¹` and inverses) by
homotopies inside the star-shaped regions `H±`.  A Lebesgue-number subdivision of an arbitrary
path then concludes.
-/

@[expose] public section

open Polynomial Set Filter Topology Metric Complex PolyCover MonodromyRelation
open scoped Real

noncomputable section

namespace Pi1Gen

variable {P : ℂ[X]}

/-- The subgroup generated by two loop classes, as an inductive predicate. -/
inductive InGen {A : Base P} (γ0 γ1 : Path.Homotopic.Quotient A A) :
    Path.Homotopic.Quotient A A → Prop
  | refl : InGen γ0 γ1 (Path.Homotopic.Quotient.refl A)
  | gen0 : InGen γ0 γ1 γ0
  | gen1 : InGen γ0 γ1 γ1
  | trans {a b} : InGen γ0 γ1 a → InGen γ0 γ1 b → InGen γ0 γ1 (a.trans b)
  | symm {a} : InGen γ0 γ1 a → InGen γ0 γ1 a.symm

/-! ### Three open star-shaped sets covering `ℂ \ {0, 1}` -/

/-- `O₁ = ℂ \ ((-∞, 0] ∪ [1, ∞))`. -/
def O1 : Set ℂ := {z | z.im ≠ 0 ∨ (0 < z.re ∧ z.re < 1)}
/-- `O₂ = ℂ \ [0, ∞)`. -/
def O2 : Set ℂ := {z | z.im ≠ 0 ∨ z.re < 0}
/-- `O₃ = ℂ \ (-∞, 1]`. -/
def O3 : Set ℂ := {z | z.im ≠ 0 ∨ 1 < z.re}

theorem isOpen_O1 : IsOpen O1 :=
  (isOpen_ne_fun continuous_im continuous_const).union
    ((isOpen_lt continuous_const continuous_re).inter (isOpen_lt continuous_re continuous_const))

theorem isOpen_O2 : IsOpen O2 :=
  (isOpen_ne_fun continuous_im continuous_const).union (isOpen_lt continuous_re continuous_const)

theorem isOpen_O3 : IsOpen O3 :=
  (isOpen_ne_fun continuous_im continuous_const).union (isOpen_lt continuous_const continuous_re)

/-- Convex combinations with a real centre. -/
theorem comb_im (c : ℝ) (z : ℂ) (a b : ℝ) : (a • (c : ℂ) + b • z).im = b * z.im := by simp

theorem comb_re (c : ℝ) (z : ℂ) (a b : ℝ) : (a • (c : ℂ) + b • z).re = a * c + b * z.re := by
  simp

theorem comb_im_ne {z : ℂ} {b : ℝ} (hz : z.im ≠ 0) (hb : b ≠ 0) : b * z.im ≠ 0 :=
  mul_ne_zero hb hz

theorem starConvex_O1 {c : ℝ} (hc0 : 0 < c) (hc1 : c < 1) : StarConvex ℝ (c : ℂ) O1 := by
  intro z hz a b ha hb hab
  simp only [O1, mem_setOf_eq, comb_im, comb_re] at hz ⊢
  rcases eq_or_ne b 0 with rfl | hb0
  · right; rw [show a = 1 by linarith]; constructor <;> linarith
  rcases hz with h | ⟨h1, h2⟩
  · exact Or.inl (mul_ne_zero hb0 h)
  · have hb' : 0 < b := lt_of_le_of_ne hb (Ne.symm hb0)
    right; constructor
    · nlinarith [mul_nonneg ha hc0.le, mul_pos hb' h1]
    · nlinarith [mul_le_mul_of_nonneg_left hc1.le ha, mul_lt_mul_of_pos_left h2 hb']

theorem starConvex_O2 {c : ℝ} (hc : c < 0) : StarConvex ℝ (c : ℂ) O2 := by
  intro z hz a b ha hb hab
  simp only [O2, mem_setOf_eq, comb_im, comb_re] at hz ⊢
  rcases eq_or_ne b 0 with rfl | hb0
  · right; rw [show a = 1 by linarith]; linarith
  rcases hz with h | h
  · exact Or.inl (mul_ne_zero hb0 h)
  · have hb' : 0 < b := lt_of_le_of_ne hb (Ne.symm hb0)
    right; nlinarith [mul_nonpos_iff.2 (Or.inl ⟨ha, hc.le⟩), mul_neg_of_pos_of_neg hb' h]

theorem starConvex_O3 {c : ℝ} (hc : 1 < c) : StarConvex ℝ (c : ℂ) O3 := by
  intro z hz a b ha hb hab
  simp only [O3, mem_setOf_eq, comb_im, comb_re] at hz ⊢
  rcases eq_or_ne b 0 with rfl | hb0
  · right; rw [show a = 1 by linarith]; linarith
  rcases hz with h | h
  · exact Or.inl (mul_ne_zero hb0 h)
  · have hb' : 0 < b := lt_of_le_of_ne hb (Ne.symm hb0)
    right; nlinarith [mul_le_mul_of_nonneg_left hc.le ha, mul_lt_mul_of_pos_left h hb']

theorem ne01_of_O1 {z : ℂ} (hz : z ∈ O1) : z ≠ 0 ∧ z ≠ 1 := by
  constructor <;> rintro rfl <;> simp [O1] at hz

theorem ne01_of_O2 {z : ℂ} (hz : z ∈ O2) : z ≠ 0 ∧ z ≠ 1 := by
  constructor <;> rintro rfl <;> norm_num [O2] at hz

theorem ne01_of_O3 {z : ℂ} (hz : z ∈ O3) : z ≠ 0 ∧ z ≠ 1 := by
  constructor <;> rintro rfl <;> norm_num [O3] at hz

theorem mem_cover {z : ℂ} (h0 : z ≠ 0) (h1 : z ≠ 1) : z ∈ O1 ∨ z ∈ O2 ∨ z ∈ O3 := by
  simp only [O1, O2, O3, mem_setOf_eq]
  by_cases him : z.im = 0
  · have hre0 : z.re ≠ 0 := fun h => h0 (Complex.ext h him)
    have hre1 : z.re ≠ 1 := fun h => h1 (Complex.ext (by simpa using h) (by simpa using him))
    rcases lt_or_gt_of_ne hre0 with h | h
    · exact Or.inr (Or.inl (Or.inr h))
    · rcases lt_or_gt_of_ne hre1 with h' | h'
      · exact Or.inl (Or.inr ⟨h, h'⟩)
      · exact Or.inr (Or.inr (Or.inr h'))
  · exact Or.inl (Or.inl him)

/-- A point of a set avoiding `0, 1` with nonnegative imaginary part lies in `H₊`. -/
theorem mem_Hup_of {z : ℂ} (h0 : z ≠ 0) (h1 : z ≠ 1) (him : 0 ≤ z.im) : z ∈ Hup := by
  rcases eq_or_lt_of_le him with h | h
  · exact Or.inr ⟨h.symm, h0, h1⟩
  · exact Or.inl h

theorem mem_Hdown_of {z : ℂ} (h0 : z ≠ 0) (h1 : z ≠ 1) (him : z.im ≤ 0) : z ∈ Hdown := by
  rcases eq_or_lt_of_le him with h | h
  · exact Or.inr ⟨h, h0, h1⟩
  · exact Or.inl h

/-! ### Segments -/

theorem seg_eq_comb (a b : ℂ) (t : ℝ) : seg a b t = (1 - t) • a + t • b := by
  simp only [seg, Complex.real_smul]; push_cast; ring

theorem seg_mem_of_starConvex {S : Set ℂ} {c x : ℂ} (hS : StarConvex ℝ c S) (hx : x ∈ S)
    {t : ℝ} (ht : t ∈ Icc (0 : ℝ) 1) : seg c x t ∈ S := by
  rw [seg_eq_comb]; exact hS hx (by linarith [ht.2]) ht.1 (by ring)

theorem seg_mem_of_starConvex' {S : Set ℂ} {c x : ℂ} (hS : StarConvex ℝ c S) (hx : x ∈ S)
    {t : ℝ} (ht : t ∈ Icc (0 : ℝ) 1) : seg x c t ∈ S := by
  rw [seg_eq_comb, add_comm]; exact hS hx ht.1 (by linarith [ht.2]) (by ring)

/-- The straight segment between two points of the base, assuming it avoids the critical
values. -/
def segP (a b : Base P) (h : ∀ t ∈ Icc (0 : ℝ) 1, seg a b t ∉ critVals P) : Path a b :=
  cpath (seg a b) (continuous_seg _ _) h (seg_zero _ _) (seg_one _ _)

@[simp] theorem segP_apply (a b : Base P) (h : ∀ t ∈ Icc (0 : ℝ) 1, seg a b t ∉ critVals P)
    (t : unitInterval) : (segP a b h t : ℂ) = seg a b t := rfl

/-! ### The subdivision principle -/

/-- **Subdivision principle.**  Let `G` be a property of homotopy classes of paths which is stable
under concatenation and holds for (classes of) paths inside one member of an open cover.  Then
`G` holds for every path.  (Lebesgue number lemma on `[0, 1]`.) -/
theorem subdivision {X : Type*} [TopologicalSpace X] {ι : Type*} (U : ι → Set X)
    (hU : ∀ i, IsOpen (U i)) (hcov : ∀ x, ∃ i, x ∈ U i)
    (G : ∀ {x y : X}, Path.Homotopic.Quotient x y → Prop)
    (hmul : ∀ {x y z : X} (q : Path.Homotopic.Quotient x y) (q' : Path.Homotopic.Quotient y z),
      G q → G q' → G (q.trans q'))
    (hloc : ∀ i {x y : X} (p : Path x y), (∀ t, p t ∈ U i) → G (Path.Homotopic.Quotient.mk p))
    {x y : X} (γ : Path x y) : G (Path.Homotopic.Quotient.mk γ) := by
  obtain ⟨δ, hδ, hleb⟩ := lebesgue_number_lemma_of_metric (s := (univ : Set unitInterval))
    isCompact_univ (c := fun i => γ ⁻¹' U i) (fun i => (hU i).preimage γ.continuous)
    (fun t _ => mem_iUnion.2 (hcov (γ t)))
  obtain ⟨n, hn⟩ := exists_nat_one_div_lt hδ
  set N : ℕ := n + 1 with hN
  have hNpos : (0 : ℝ) < N := by positivity
  let s : ℕ → unitInterval := fun k => Set.projIcc 0 1 zero_le_one (k / N)
  have hs : ∀ k ≤ N, ((s k : unitInterval) : ℝ) = k / N := fun k hk => by
    simp only [s]
    rw [Set.projIcc_of_mem]
    refine ⟨by positivity, ?_⟩
    rw [div_le_one hNpos]; exact_mod_cast hk
  -- paths inside a small interval stay in one member of the cover
  have hpiece : ∀ k, k + 1 ≤ N →
      ∃ i, ∀ t, γ.subpath (s k) (s (k + 1)) t ∈ U i := by
    intro k hk
    obtain ⟨i, hi⟩ := hleb (s k) (mem_univ _)
    have hle : s k ≤ s (k + 1) := by
      show (s k : ℝ) ≤ s (k + 1)
      rw [hs k (by omega), hs (k + 1) hk]; gcongr; simp
    refine ⟨i, fun t => ?_⟩
    have hmem : γ.subpath (s k) (s (k + 1)) t ∈ range (γ.subpath (s k) (s (k + 1))) :=
      mem_range_self _
    rw [Path.range_subpath_of_le _ _ _ hle] at hmem
    obtain ⟨u, hu, hγu⟩ := hmem
    rw [← hγu]
    apply hi
    have hu1 : (s k : ℝ) ≤ u := hu.1
    have hu2 : (u : ℝ) ≤ s (k + 1) := hu.2
    rw [mem_ball, Subtype.dist_eq, Real.dist_eq, abs_of_nonneg (by linarith)]
    rw [hs (k + 1) hk] at hu2
    rw [hs k (by omega)]
    calc (u : ℝ) - k / N ≤ (k + 1 : ℕ) / N - k / N := by linarith
      _ = 1 / N := by push_cast; ring
      _ < δ := by simpa [hN] using hn
  have claim : ∀ k ≤ N, G (Path.Homotopic.Quotient.mk (γ.subpath (s 0) (s k))) := by
    intro k
    induction k with
    | zero =>
      intro _
      obtain ⟨i, hi⟩ := hcov (γ (s 0))
      exact hloc i _ fun t => by rw [Path.subpath_self]; exact hi
    | succ k ih =>
      intro hk
      obtain ⟨i, hi⟩ := hpiece k hk
      rw [← Path.Homotopic.Quotient.eq.2
        ⟨Path.Homotopy.subpathTransSubpath γ (s 0) (s k) (s (k + 1))⟩,
        Path.Homotopic.Quotient.mk_trans]
      exact hmul _ _ (ih (by omega)) (hloc i _ hi)
  have h0 : s 0 = 0 := Subtype.ext (by rw [hs 0 (by omega)]; simp)
  have h1 : s N = 1 := Subtype.ext (by rw [hs N le_rfl]; simp [hNpos.ne'])
  have := claim N le_rfl
  rw [h0, h1, Path.subpath_zero_one, Path.Homotopic.Quotient.mk_cast] at this
  have hcast : ∀ (x' y' : X) (hx : x' = x) (hy : y' = y),
      G ((Path.Homotopic.Quotient.mk γ).cast hx hy) → G (Path.Homotopic.Quotient.mk γ) := by
    intro x' y' hx hy
    subst hx hy
    simp
  exact hcast _ _ _ _ this

/-! ### Canonical classes joining the base point to every point -/

section Canonical

variable (hcrit : critVals P = {0, 1})
include hcrit

theorem notCrit {z : ℂ} (h0 : z ≠ 0) (h1 : z ≠ 1) : z ∉ critVals P := by
  rw [hcrit]; simp [h0, h1]

theorem ne01 (x : Base P) : (x : ℂ) ≠ 0 ∧ (x : ℂ) ≠ 1 := by
  obtain ⟨z, hz⟩ := x
  have h : z ∉ critVals P := hz
  rw [hcrit] at h; simpa [not_or] using h

theorem Hup_sub : Hup ⊆ (critVals P)ᶜ := Hup_subset hcrit.le
theorem Hdown_sub : Hdown ⊆ (critVals P)ᶜ := Hdown_subset hcrit.le

/-- The point `i` of the base. -/
def Ip : Base P := ⟨I, notCrit hcrit (by simp) (by simp [Complex.ext_iff])⟩
/-- The point `-i` of the base. -/
def mIp : Base P := ⟨-I, notCrit hcrit (by simp) (by simp [Complex.ext_iff])⟩

theorem mem_Hup_base {x : Base P} (h : 0 ≤ (x : ℂ).im) : (x : ℂ) ∈ Hup :=
  mem_Hup_of (ne01 hcrit x).1 (ne01 hcrit x).2 h

theorem mem_Hdown_base {x : Base P} (h : (x : ℂ).im ≤ 0) : (x : ℂ) ∈ Hdown :=
  mem_Hdown_of (ne01 hcrit x).1 (ne01 hcrit x).2 h

/-- The path `x → i` (for `Im x ≥ 0`) followed by `i → y` (for `Im y ≥ 0`), inside `H₊`. -/
def viaI (x y : Base P) (hx : 0 ≤ (x : ℂ).im) (hy : 0 ≤ (y : ℂ).im) : Path x y :=
  (segP x (Ip hcrit) fun _ ht => Hup_sub hcrit
      (seg_mem_of_starConvex' starConvex_Hup (mem_Hup_base hcrit hx) ht)).trans
    (segP (Ip hcrit) y fun _ ht => Hup_sub hcrit
      (seg_mem_of_starConvex starConvex_Hup (mem_Hup_base hcrit hy) ht))

/-- The path `x → -i → y` inside `H₋`. -/
def viaMI (x y : Base P) (hx : (x : ℂ).im ≤ 0) (hy : (y : ℂ).im ≤ 0) : Path x y :=
  (segP x (mIp hcrit) fun _ ht => Hdown_sub hcrit
      (seg_mem_of_starConvex' starConvex_Hdown (mem_Hdown_base hcrit hx) ht)).trans
    (segP (mIp hcrit) y fun _ ht => Hdown_sub hcrit
      (seg_mem_of_starConvex starConvex_Hdown (mem_Hdown_base hcrit hy) ht))

theorem viaI_mem (x y : Base P) (hx : 0 ≤ (x : ℂ).im) (hy : 0 ≤ (y : ℂ).im) :
    ∀ t, (viaI hcrit x y hx hy t : ℂ) ∈ Hup :=
  mem_trans (fun t => seg_mem_of_starConvex' starConvex_Hup (mem_Hup_base hcrit hx) t.2)
    (fun t => seg_mem_of_starConvex starConvex_Hup (mem_Hup_base hcrit hy) t.2)

theorem viaMI_mem (x y : Base P) (hx : (x : ℂ).im ≤ 0) (hy : (y : ℂ).im ≤ 0) :
    ∀ t, (viaMI hcrit x y hx hy t : ℂ) ∈ Hdown :=
  mem_trans (fun t => seg_mem_of_starConvex' starConvex_Hdown (mem_Hdown_base hcrit hx) t.2)
    (fun t => seg_mem_of_starConvex starConvex_Hdown (mem_Hdown_base hcrit hy) t.2)

variable {A : Base P} (hA : (A : ℂ).im = 0)
include hA

/-- **The canonical class `c(x)` from the base point `A` to `x`**: through `i` if `Im x ≥ 0`,
through `-i` otherwise. -/
def cls (x : Base P) : Path.Homotopic.Quotient A x :=
  if h : 0 ≤ (x : ℂ).im then Path.Homotopic.Quotient.mk (viaI hcrit A x hA.ge h)
  else Path.Homotopic.Quotient.mk (viaMI hcrit A x hA.le (le_of_lt (not_le.1 h)))

/-- `c(x)` is the class of any path from `A` to `x` inside `H₊`, if `Im x ≥ 0`. -/
theorem cls_up {x : Base P} (hx : 0 ≤ (x : ℂ).im) (q : Path A x) (hq : ∀ t, (q t : ℂ) ∈ Hup) :
    cls hcrit hA x = Path.Homotopic.Quotient.mk q := by
  rw [cls, dif_pos hx]
  exact Path.Homotopic.Quotient.eq.2
    (homotopic_of_starConvex starConvex_Hup (Hup_sub hcrit) _ _ (viaI_mem hcrit _ _ _ _) hq)

/-- `c(x)` is the class of any path from `A` to `x` inside `H₋`, if `Im x < 0`. -/
theorem cls_down {x : Base P} (hx : (x : ℂ).im < 0) (q : Path A x)
    (hq : ∀ t, (q t : ℂ) ∈ Hdown) : cls hcrit hA x = Path.Homotopic.Quotient.mk q := by
  rw [cls, dif_neg (not_le.2 hx)]
  exact Path.Homotopic.Quotient.eq.2
    (homotopic_of_starConvex starConvex_Hdown (Hdown_sub hcrit) _ _ (viaMI_mem hcrit _ _ _ _) hq)

theorem cls_self : cls hcrit hA A = Path.Homotopic.Quotient.refl A :=
  cls_up hcrit hA hA.ge (Path.refl A) fun _ => mem_Hup_base hcrit hA.ge

omit hcrit hA in
theorem quot_conj_cancel {a c x y : Base P} (E E' : Path.Homotopic.Quotient a c)
    (sx : Path.Homotopic.Quotient c x) (sy : Path.Homotopic.Quotient c y)
    (q : Path.Homotopic.Quotient x y)
    (h : sx.trans (q.trans sy.symm) = Path.Homotopic.Quotient.refl c) :
    (E.trans sx).trans (q.trans (E'.trans sy).symm) = E.trans E'.symm := by
  rw [quot_symm_trans, Path.Homotopic.Quotient.trans_assoc,
    show sx.trans (q.trans (sy.symm.trans E'.symm)) = (sx.trans (q.trans sy.symm)).trans E'.symm by
      simp only [Path.Homotopic.Quotient.trans_assoc], h, Path.Homotopic.Quotient.refl_trans]

/-- **The local step.**  Let `O` be a star-shaped set (centre `C`, a real point) avoiding `0, 1`.
If `u` (in `H₊`) and `d` (in `H₋`) are paths from `A` to `C` with `u · d⁻¹` in the subgroup, then
for every path `p` inside `O`, the loop `c(x) · p · c(y)⁻¹` is in the subgroup. -/
theorem local_step {γ0 γ1 : Path.Homotopic.Quotient A A} {O : Set ℂ} {C : Base P}
    (hO : StarConvex ℝ (C : ℂ) O) (hOX : ∀ z ∈ O, z ≠ 0 ∧ z ≠ 1) (hCim : (C : ℂ).im = 0)
    (u : Path A C) (hu : ∀ t, (u t : ℂ) ∈ Hup) (d : Path A C) (hd : ∀ t, (d t : ℂ) ∈ Hdown)
    (hE : InGen γ0 γ1 ((Path.Homotopic.Quotient.mk u).trans (Path.Homotopic.Quotient.mk d).symm))
    {x y : Base P} (p : Path x y) (hp : ∀ t, (p t : ℂ) ∈ O) :
    InGen γ0 γ1 ((cls hcrit hA x).trans
      ((Path.Homotopic.Quotient.mk p).trans (cls hcrit hA y).symm)) := by
  have hOsub : O ⊆ (critVals P)ᶜ := fun z hz => notCrit hcrit (hOX z hz).1 (hOX z hz).2
  let sC : (z : Base P) → (z : ℂ) ∈ O → Path C z := fun z hz =>
    segP C z fun _ ht => hOsub (seg_mem_of_starConvex hO hz ht)
  have sC_mem : ∀ z hz t, ((sC z hz t : Base P) : ℂ) ∈ O := fun z hz t =>
    seg_mem_of_starConvex hO hz t.2
  have sC_im : ∀ z hz (t : unitInterval), ((sC z hz t : Base P) : ℂ).im = t * (z : ℂ).im :=
    fun z hz t => by simp [sC, seg, hCim]
  have key : ∀ (z : Base P) (hz : (z : ℂ) ∈ O),
      (cls hcrit hA z = (Path.Homotopic.Quotient.mk u).trans (Path.Homotopic.Quotient.mk (sC z hz))
        ∧ 0 ≤ (z : ℂ).im) ∨
      (cls hcrit hA z = (Path.Homotopic.Quotient.mk d).trans (Path.Homotopic.Quotient.mk (sC z hz))
        ∧ (z : ℂ).im < 0) := by
    intro z hz
    by_cases him : 0 ≤ (z : ℂ).im
    · left
      refine ⟨?_, him⟩
      rw [← Path.Homotopic.Quotient.mk_trans]
      refine cls_up hcrit hA him _ (mem_trans hu fun t => ?_)
      exact mem_Hup_of (hOX _ (sC_mem z hz t)).1 (hOX _ (sC_mem z hz t)).2
        (by rw [sC_im z hz]; exact mul_nonneg t.2.1 him)
    · right
      have him' : (z : ℂ).im < 0 := not_le.1 him
      refine ⟨?_, him'⟩
      rw [← Path.Homotopic.Quotient.mk_trans]
      refine cls_down hcrit hA him' _ (mem_trans hd fun t => ?_)
      exact mem_Hdown_of (hOX _ (sC_mem z hz t)).1 (hOX _ (sC_mem z hz t)).2
        (by rw [sC_im z hz]; exact mul_nonpos_of_nonneg_of_nonpos t.2.1 him'.le)
  have hx : (x : ℂ) ∈ O := by simpa using hp 0
  have hy : (y : ℂ) ∈ O := by simpa using hp 1
  have hloop : (Path.Homotopic.Quotient.mk (sC x hx)).trans ((Path.Homotopic.Quotient.mk p).trans
      (Path.Homotopic.Quotient.mk (sC y hy)).symm) = Path.Homotopic.Quotient.refl C := by
    rw [← Path.Homotopic.Quotient.mk_symm, ← Path.Homotopic.Quotient.mk_trans,
      ← Path.Homotopic.Quotient.mk_trans, ← Path.Homotopic.Quotient.mk_refl]
    exact Path.Homotopic.Quotient.eq.2 (homotopic_of_starConvex hO hOsub _ _
      (mem_trans (sC_mem x hx) (mem_trans hp (mem_symm (sC_mem y hy))))
      fun _ => by simpa using hO.mem ⟨_, hx⟩)
  rcases key x hx with ⟨ex, -⟩ | ⟨ex, -⟩ <;> rcases key y hy with ⟨ey, -⟩ | ⟨ey, -⟩ <;>
    rw [ex, ey, quot_conj_cancel _ _ _ _ _ hloop]
  · rw [Path.Homotopic.Quotient.trans_symm]; exact InGen.refl
  · exact hE
  · have := InGen.symm hE
    rwa [quot_symm_trans, quot_symm_symm] at this
  · rw [Path.Homotopic.Quotient.trans_symm]; exact InGen.refl

end Canonical

end Pi1Gen

namespace Pi1Gen

variable {P : ℂ[X]}

/-- **The standard loops generate `π₁(ℂ \ {0,1}, -r)`.**  If `critVals P = {0, 1}` and `γ₀, γ₁`
are the standard generators at `-r` (`0 < r < 1/2`), then every homotopy class of loops at `-r`
in `ℂ \ {0,1}` lies in the subgroup generated by `γ₀` and `γ₁`. -/
theorem isStdLoops_generate (hcrit : critVals P = {0, 1}) {r : ℝ} (hr : 0 < r) (hr2 : r < 1 / 2)
    {A : Base P} {γ0 γ1 : Path.Homotopic.Quotient A A} (hs : IsStdLoops r γ0 γ1)
    (γ : Path.Homotopic.Quotient A A) : InGen γ0 γ1 γ := by
  obtain ⟨B, C, D, U0, L0, U1, L1, sBC, hU0, hL0, hU1, hL1, hsBC, e0, e1⟩ := hs
  have hA : (A : ℂ) = -r := by
    rw [← congrArg Subtype.val U0.target, hU0]; simp [upper_one]
  have hB : (B : ℂ) = r := by
    rw [← congrArg Subtype.val U0.source, hU0]; simp [upper_zero]
  have hD : (D : ℂ) = 1 + r := by
    rw [← congrArg Subtype.val U1.source, hU1]; simp [upper_zero]
  have hAim : (A : ℂ).im = 0 := by rw [hA]; simp
  have mU0 : ∀ t, (U0 t : ℂ) ∈ Hup := fun t => by rw [hU0]; exact hm_upper0 hr hr2 t t.2
  have mL0 : ∀ t, (L0 t : ℂ) ∈ Hdown := fun t => by rw [hL0]; exact hm_lower0 hr hr2 t t.2
  have mU1 : ∀ t, (U1 t : ℂ) ∈ Hup := fun t => by rw [hU1]; exact hm_upper1 hr hr2 t t.2
  have mL1 : ∀ t, (L1 t : ℂ) ∈ Hdown := fun t => by rw [hL1]; exact hm_lower1 hr hr2 t t.2
  have ms : ∀ t, (sBC t : ℂ) ∈ Hup ∩ Hdown := fun t => by rw [hsBC]; exact hm_segBC hr hr2 t t.2
  -- the property to propagate
  let G : ∀ {x y : Base P}, Path.Homotopic.Quotient x y → Prop := fun {x y} q =>
    InGen γ0 γ1 ((cls hcrit hAim x).trans (q.trans (cls hcrit hAim y).symm))
  have hmul : ∀ {x y z : Base P} (q : Path.Homotopic.Quotient x y)
      (q' : Path.Homotopic.Quotient y z), G q → G q' → G (q.trans q') := by
    intro x y z q q' hq hq'
    have := InGen.trans hq hq'
    simp only [G, Path.Homotopic.Quotient.trans_assoc, quot_cancel'] at this ⊢
    exact this
  -- the three local steps
  have hO1 : ∀ {x y : Base P} (p : Path x y), (∀ t, (p t : ℂ) ∈ O1) → G
      (Path.Homotopic.Quotient.mk p) := by
    intro x y p hp
    refine local_step hcrit hAim (C := B) (hB ▸ starConvex_O1 hr (by linarith))
      (fun z hz => ne01_of_O1 hz) (by rw [hB]; simp) U0.symm (mem_symm mU0) L0 mL0 ?_ p hp
    have key : (Path.Homotopic.Quotient.mk U0.symm).trans (Path.Homotopic.Quotient.mk L0).symm =
        γ0.symm := by rw [e0, quot_symm_trans]; rfl
    rw [key]; exact InGen.symm InGen.gen0
  have hO2 : ∀ {x y : Base P} (p : Path x y), (∀ t, (p t : ℂ) ∈ O2) → G
      (Path.Homotopic.Quotient.mk p) := by
    intro x y p hp
    have hAup : (A : ℂ) ∈ Hup := mem_Hup_base hcrit hAim.ge
    have hAdown : (A : ℂ) ∈ Hdown := mem_Hdown_base hcrit hAim.le
    have hst : StarConvex ℝ (A : ℂ) O2 := by
      have := starConvex_O2 (c := -r) (by linarith); push_cast at this; rw [hA]; exact this
    refine local_step hcrit hAim (C := A) hst
      (fun z hz => ne01_of_O2 hz) hAim (Path.refl A) (fun _ => hAup) (Path.refl A)
      (fun _ => hAdown) ?_ p hp
    rw [Path.Homotopic.Quotient.trans_symm]; exact InGen.refl
  have hO3 : ∀ {x y : Base P} (p : Path x y), (∀ t, (p t : ℂ) ∈ O3) → G
      (Path.Homotopic.Quotient.mk p) := by
    intro x y p hp
    have hst : StarConvex ℝ (D : ℂ) O3 := by
      have := starConvex_O3 (c := 1 + r) (by linarith); push_cast at this; rw [hD]; exact this
    refine local_step hcrit hAim (C := D) hst
      (fun z hz => ne01_of_O3 hz) (by rw [hD]; simp) ((U0.symm.trans sBC).trans U1.symm)
      (mem_trans (mem_trans (mem_symm mU0) fun t => (ms t).1) (mem_symm mU1))
      ((L0.trans sBC).trans L1) (mem_trans (mem_trans mL0 fun t => (ms t).2) mL1) ?_ p hp
    have key : (Path.Homotopic.Quotient.mk ((U0.symm.trans sBC).trans U1.symm)).trans
        (Path.Homotopic.Quotient.mk ((L0.trans sBC).trans L1)).symm = γ1.symm.trans γ0.symm := by
      rw [e0, e1]
      simp only [Path.Homotopic.Quotient.mk_trans, Path.Homotopic.Quotient.mk_symm,
        quot_symm_trans, quot_symm_symm, Path.Homotopic.Quotient.trans_assoc, quot_cancel]
    rw [key]; exact InGen.trans (InGen.symm InGen.gen1) (InGen.symm InGen.gen0)
  -- the open cover of the base
  let U : Fin 3 → Set (Base P) := ![Subtype.val ⁻¹' O1, Subtype.val ⁻¹' O2, Subtype.val ⁻¹' O3]
  have hU : ∀ i, IsOpen (U i) := by
    intro i; fin_cases i
    · exact isOpen_O1.preimage continuous_subtype_val
    · exact isOpen_O2.preimage continuous_subtype_val
    · exact isOpen_O3.preimage continuous_subtype_val
  have hcov : ∀ x, ∃ i, x ∈ U i := by
    intro x
    rcases mem_cover (ne01 hcrit x).1 (ne01 hcrit x).2 with h | h | h
    · exact ⟨0, h⟩
    · exact ⟨1, h⟩
    · exact ⟨2, h⟩
  have hloc : ∀ i {x y : Base P} (p : Path x y), (∀ t, p t ∈ U i) →
      G (Path.Homotopic.Quotient.mk p) := by
    intro i x y p hp
    fin_cases i
    · exact hO1 p hp
    · exact hO2 p hp
    · exact hO3 p hp
  induction γ using Path.Homotopic.Quotient.ind with | mk γ =>
  have := subdivision U hU hcov G hmul hloc γ
  have hrs : (Path.Homotopic.Quotient.refl A).symm = Path.Homotopic.Quotient.refl A := by
    rw [← Path.Homotopic.Quotient.mk_refl, ← Path.Homotopic.Quotient.mk_symm, Path.refl_symm]
  simp only [G, cls_self, Path.Homotopic.Quotient.refl_trans, hrs,
    Path.Homotopic.Quotient.trans_refl] at this
  exact this

end Pi1Gen
