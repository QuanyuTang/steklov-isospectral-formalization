import RequestProject.MainTheoremClassical
import RequestProject.C1Spectrum
import RequestProject.OrbMetricSpectrum
import RequestProject.Degree7RiemannCover
import RequestProject.PuncturedDiskCover
import RequestProject.Degree7Quotient
import RequestProject.Degree7Prop331
import RequestProject.Degree7Prop331Geom
import RequestProject.Degree7Prop331Full
import Lean

noncomputable section

/-! Independent audit of the final run-20 candidate; full original-paper requirements are reviewed separately from the machine checks. -/

open Lean Elab Command

elab "#audit_proof " n:ident : command => do
  let name := n.getId
  let info ← getConstInfo name
  unless (← liftTermElabM (Meta.isProp info.type)) do
    throwError "audit rejected: declaration type is not a proposition"
  unless info.hasValue (allowOpaque := true) do
    throwError "audit rejected: declaration has no proof body"
  let axioms ← collectAxioms name
  let unexpected := axioms.filter fun ax =>
    ax != ``propext && ax != ``Classical.choice && ax != ``Quot.sound
  unless unexpected.isEmpty do
    throwError "audit rejected: unapproved transitive axioms {unexpected}"
  logInfo m!"AUDIT_OK {name}: {axioms.toList}"

/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof MainTheorem

-- A passing build must retain this explicit distinction.
#check MainTheorem -- MainTheorem : Prop, not a proof of MainTheorem.


/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof MainTheoremH1

/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof MainTheoremWeak


/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof MainTheoremDom

/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof MainTheoremClassical

elab "#audit_construction " n:ident : command => do
  let name := n.getId
  let info ← getConstInfo name
  if (← liftTermElabM (Meta.isProp info.type)) || info.type.isSort then
    throwError "audit rejected: construction must be an object, not a proof or sort-valued statement"
  unless info.hasValue (allowOpaque := true) do
    throwError "audit rejected: construction has no body"
  let axioms ← collectAxioms name
  let unexpected := axioms.filter fun ax =>
    ax != ``propext && ax != ``Classical.choice && ax != ``Quot.sound
  unless unexpected.isEmpty do
    throwError "audit rejected: unapproved transitive axioms {unexpected}"
  logInfo m!"CONSTRUCTION_OK {name}: {axioms.toList}"

/-- error: audit rejected: construction must be an object, not a proof or sort-valued statement -/
#guard_msgs in
#audit_construction MainTheorem

/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof SteklovH1.ConfMap.sobolevPullback


/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof Prop_2_1_1_C1


/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof SteklovC1.Prop_2_1_1_C1_Weak

/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof SteklovH1.C1Conf.sobolevPullback


/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof SteklovOrb.DiskOrbisurface.metricSobolevEquiv

/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof SteklovOrb.DiskOrbisurface.metricSobolevEquivOrb


/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof Degree7.regEnds

/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof Degree7.regFillHomeo

/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof SteklovFill.Fill.cuspChart

/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof SteklovFill.Fill.homeoMap

/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof SteklovFill.branchEnds


/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof Degree7.stabSub

/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof Degree7.orbSetoid

/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof SteklovOrb.pullbackOrb


elab "#audit_statement " n:ident : command => do
  let name := n.getId
  let info ← getConstInfo name
  let isPredicate ← liftTermElabM <| Meta.forallTelescopeReducing info.type fun _ result =>
    pure (result == mkSort Level.zero)
  unless isPredicate do
    throwError "audit rejected: statement definition must return Prop"
  unless info.hasValue (allowOpaque := true) do
    throwError "audit rejected: statement definition has no body"
  let axioms ← collectAxioms name
  let unexpected := axioms.filter fun ax =>
    ax != ``propext && ax != ``Classical.choice && ax != ``Quot.sound
  unless unexpected.isEmpty do
    throwError "audit rejected: unapproved transitive axioms {unexpected}"
  logInfo m!"STATEMENT_ONLY {name}: {axioms.toList}"

/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof Degree7.deckIso

/-- error: audit rejected: declaration type is not a proposition -/
#guard_msgs in
#audit_proof Degree7.regMetric

/-- error: audit rejected: declaration type is not a proposition -/
